function errorClassFromStatusCode(statusCode) {
  if (statusCode === void 0) {
    return DaytonaError;
  }
  return STATUS_CODE_TO_ERROR[statusCode] || DaytonaError;
}
function createDaytonaError(message, statusCode, headers, code, source) {
