  }
  if (source instanceof stream4.Readable)
    return source;
  if (typeof source.getReader === "function") {
    return stream4.Readable.fromWeb(source);
  }
  throw new DaytonaError(`Unsupported upload source: ${source.constructor?.name ?? typeof source}`);
}
function wrapWithUploadProgress(source, onProgress, signal) {
  if (!onProgress && !signal)
    return source;
  const errPrefix = "Uploading files is not supported: ";
  const { Transform, pipeline } = dynamicRequire("stream", errPrefix);
  let bytesSent = 0;
  const tracker = new Transform({
    transform(chunk, _encoding, callback) {
      const buf = Buffer.isBuffer(chunk) ? chunk : Buffer.from(chunk);
      bytesSent += buf.length;
      onProgress?.({ bytesSent });
      callback(null, buf);
    }
  });
  pipeline(source, tracker, (err2) => {
    if (!err2)
      return;
    if (!source.destroyed)
      source.destroy(err2);
    if (!tracker.destroyed)
      tracker.destroy(err2);
  });
  if (signal) {
    const onAbort = () => {
      const abortError = new Error("aborted");
      if (!source.destroyed)
        source.destroy(abortError);
      if (!tracker.destroyed)
        tracker.destroy(abortError);
    };
    if (signal.aborted) {
      queueMicrotask(onAbort);
    } else {
      signal.addEventListener("abort", onAbort, { once: true });
      tracker.on("close", () => signal.removeEventListener("abort", onAbort));
    }
  }
  return tracker;
}

