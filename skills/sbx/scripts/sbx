var PintFsClient = class {
  constructor(apiClient) {
    this.apiClient = apiClient;
  }
  async readFile(path2) {
    try {
      const response = await readFile3({
        client: this.apiClient,
        path: {
          path: path2
        }
      });
      if (response.data) {
        const encoder = new TextEncoder();
        const content = encoder.encode(response.data.content);
        return {
          type: "ok",
          result: {
            content
          }
        };
      } else {
        return {
          type: "error",
          error: response.error?.message || "Failed to read file",
          errno: null
        };
      }
    } catch (error) {
      return {
        type: "error",
        error: error instanceof Error ? error.message : "Unknown error",
        errno: null
      };
    }
  }
  async readdir(path2) {
    try {
      const response = await listDirectory({
        client: this.apiClient,
        path: {
          path: path2
        }
      });
      if (response.data) {
        const entries = response.data.files.map((fileInfo) => ({
          name: fileInfo.name,
          type: fileInfo.isDir ? 1 : 0,
          // 1 = directory, 0 = file
          isSymlink: false
          // API doesn't provide symlink info, defaulting to false
        }));
        return {
          type: "ok",
          result: {
            entries
          }
        };
      } else {
        return {
          type: "error",
          error: response.error?.message || "Failed to read directory",
          errno: null
        };
      }
    } catch (error) {
      return {
        type: "error",
        error: error instanceof Error ? error.message : "Unknown error",
        errno: null
      };
    }
  }
  async writeFile(path2, content, create2, overwrite) {
    try {
      const decoder = new TextDecoder();
      const contentString = decoder.decode(content);
      const response = await createFile({
        client: this.apiClient,
        path: {
          path: path2
        },
        body: {
          content: contentString
        }
      });
      if (response.data) {
        return {
          type: "ok",
          result: {}
        };
      } else {
        return {
          type: "error",
          error: response.error?.message || "Failed to write file",
          errno: null
        };
      }
    } catch (error) {
      return {
        type: "error",
        error: error instanceof Error ? error.message : "Unknown error",
        errno: null
      };
    }
  }
  async remove(path2, recursive) {
    try {
      const response = await deleteDirectory({
        client: this.apiClient,
        path: {
          path: path2
        }
      });
      if (response.data) {
        return {
          type: "ok",
          result: {}
        };
      } else {
        return {
          type: "error",
          error: response.error?.message || "Failed to remove directory",
          errno: null
        };
      }
    } catch (error) {
      return {
        type: "error",
        error: error instanceof Error ? error.message : "Unknown error",
        errno: null
      };
    }
  }
  async mkdir(path2, recursive) {
    try {
      const response = await createDirectory({
        client: this.apiClient,
        path: {
          path: path2
        }
      });
      if (response.data) {
        return {
          type: "ok",
          result: {}
        };
      } else {
        return {
          type: "error",
          error: response.error?.message || "Failed to create directory",
          errno: null
        };
      }
    } catch (error) {
      return {
        type: "error",
        error: error instanceof Error ? error.message : "Unknown error",
        errno: null
      };
    }
  }
  async stat(path2) {
    try {
      const response = await getFileStat({
        client: this.apiClient,
        path: {
          path: path2
        }
      });
      if (response.data) {
        const modTimeMs = new Date(response.data.modTime).getTime();
        return {
          type: "ok",
          result: {
            type: response.data.isDir ? 1 : 0,
            // 1 = directory, 0 = file
            isSymlink: false,
            // API doesn't provide symlink info, defaulting to false
            size: response.data.size,
            mtime: modTimeMs,
            ctime: modTimeMs,
            // Using modTime as fallback since API doesn't provide ctime
            atime: modTimeMs
            // Using modTime as fallback since API doesn't provide atime
          }
        };
      } else {
        return {
          type: "error",
          error: response.error?.message || "Failed to get file stat",
          errno: null
        };
      }
    } catch (error) {
      return {
        type: "error",
        error: error instanceof Error ? error.message : "Unknown error",
        errno: null
      };
    }
  }
  async copy(from, to, recursive, overwrite) {
    try {
      const response = await performFileAction({
        client: this.apiClient,
        path: {
          path: from
        },
        body: {
          action: "copy",
          destination: to
        }
      });
      if (response.data) {
        return {
          type: "ok",
          result: {}
        };
      } else {
        return {
          type: "error",
          error: response.error?.message || "Failed to copy file",
          errno: null
        };
      }
    } catch (error) {
      return {
        type: "error",
        error: error instanceof Error ? error.message : "Unknown error",
        errno: null
      };
    }
  }
  async rename(from, to, overwrite) {
    try {
      const response = await performFileAction({
        client: this.apiClient,
        path: {
          path: from
        },
        body: {
          action: "move",
          destination: to
        }
      });
      if (response.data) {
        return {
          type: "ok",
          result: {}
        };
      } else {
        return {
          type: "error",
          error: response.error?.message || "Failed to rename/move file",
          errno: null
        };
      }
    } catch (error) {
      return {
        type: "error",
        error: error instanceof Error ? error.message : "Unknown error",
        errno: null
      };
    }
  }
  async watch(path2, options, onEvent) {
    throw new Error("Not implemented");
