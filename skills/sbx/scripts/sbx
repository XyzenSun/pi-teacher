var SliceList = class {
  constructor() {
    this.idx = 0;
    this.store = /* @__PURE__ */ new Map();
  }
  /**
   * Add a value to the list
   *
   * @returns a unique reference to delete the item
   */
  add(value2) {
    const nextIdx = this.idx + 1;
    this.idx = nextIdx;
    this.store.set(nextIdx, value2);
    return nextIdx;
  }
  /**
   * Remove a value using the unique reference
   */
  remove(idx) {
    this.store.delete(idx);
  }
  /**
   * Get values as an iterator
   */
  values() {
    return this.store.values();
  }
  /**
   * Get values as an array
   */
  array() {
    return Array.from(this.store.values());
  }
  /**
   * Get amount of items in the list
   */
  size() {
    return this.store.size;
  }
};
var AgentConnection = class _AgentConnection {
  constructor(connection, url3) {
    this.connection = connection;
    this.url = url3;
    this._state = "CONNECTING";
    this._isDisposed = false;
    this.onStateChangeEmitter = new Emitter7();
    this.onStateChange = this.onStateChangeEmitter.event;
    this.nextMessageId = 0;
    this.pendingMessages = /* @__PURE__ */ new Map();
    this.messageQueue = [];
    this.notificationListeners = {};
    this.messageEmitter = new Emitter7();
    this.onMessage = this.messageEmitter.event;
    this.errorEmitter = new Emitter7();
    this.onError = this.errorEmitter.event;
    this.subscribeConnection(connection);
    this.onNotification("system/hibernate", () => {
      this.state = "HIBERNATED";
    });
  }
  static async create(url3) {
    const ws = await createWebSocketClient(url3);
    return new _AgentConnection(ws, url3);
  }
  get state() {
    return this._state;
  }
  set state(state) {
    this._state = state;
    this.onStateChangeEmitter.fire(state);
    if (state === "DISCONNECTED" || state === "HIBERNATED") {
      this.connection.dispose();
    }
  }
  subscribeConnection(connection) {
    connection.onMessage((message) => {
      this.receiveMessage(message);
    });
    connection.onDisconnected(() => {
      this.state = "DISCONNECTED";
    });
    connection.onMissingHeartbeat(() => {
      if (this.pendingMessages.size === 0) {
        setTimeout(() => {
          if (this.pendingMessages.size === 0 && this.state === "CONNECTED") {
            this.state = "DISCONNECTED";
          }
        }, 1e3);
      }
    });
  }
  onNotification(method, cb) {
    let listeners = this.notificationListeners[method];
    if (!listeners) {
      listeners = this.notificationListeners[method] = new SliceList();
    }
    const idx = listeners.add(cb);
    return () => {
      this.notificationListeners[method]?.remove(idx);
    };
  }
  receiveMessage(blob) {
    const payload = decodeMessage(blob);
    this.messageEmitter.fire(payload);
    const method = payload.method;
    if (isNotificationPayload(payload)) {
      const listeners = this.notificationListeners[method];
      if (listeners) {
        for (const cb of listeners.values()) {
          cb(payload.params);
        }
      }
      return;
    }
    let response;
    if (isErrorPayload(payload)) {
      response = {
        status: 1,
        error: {
          code: payload.error.code,
          data: payload.error.data,
          message: payload.error.message
        },
        method
      };
    } else if (isResultPayload(payload)) {
      response = {
        status: 0,
        result: payload.result,
        method
      };
    } else {
      throw new Error("Unable to identify message type");
    }
    const messageToResolve = this.pendingMessages.get(payload.id);
    if (messageToResolve) {
      messageToResolve.resolve(response);
    }
  }
  request(pitcherRequest, options = {}) {
    if (this._isDisposed) {
      throw new Error(
        "Cannot perform operation: SandboxClient has been disposed"
      );
    }
    const { timeoutMs } = options;
    const request = this.createRequest(pitcherRequest, timeoutMs);
    if (this.state !== "CONNECTED" && this.state !== "CONNECTING") {
      this.messageQueue.push(request);
      return request.unwrap();
    }
    try {
      this.connection.send(request.message);
      return request.unwrap();
    } catch (error) {
      this.messageQueue.push(request);
      this.errorEmitter.fire({
        message: error.message,
        extras: {
          source: "pitcher-message-handler",
          type: "send-request",
          request: pitcherRequest
        }
      });
      return request.unwrap();
    }
  }
  createRequest(request, timeoutMs) {
    const id = this.nextMessageId++;
    const pitcherMessage = new PendingPitcherMessage(id, request, timeoutMs);
    this.pendingMessages.set(id, pitcherMessage);
    pitcherMessage.onDidDispose(() => this.pendingMessages.delete(id));
    return pitcherMessage;
  }
  disposePendingMessages() {
    this.pendingMessages.forEach((pendingMessage) => {
      pendingMessage.dispose();
    });
  }
  async disconnect() {
    if (this.pendingMessages.size) {
      await new Promise((resolve2) => {
        const interval = setInterval(() => {
          if (this.pendingMessages.size) {
            return;
          }
          clearInterval(interval);
          resolve2();
        }, 50);
      });
    }
    this.state = "DISCONNECTED";
  }
  async reconnect(reconnectToken, startVm) {
    if (!(this.state === "DISCONNECTED" || this.state === "HIBERNATED")) {
      return void 0;
    }
    this.pendingMessages.forEach((msg) => {
      if (!msg.isDisposed) {
        this.messageQueue.unshift(msg);
      }
    });
    this.pendingMessages.clear();
    this.state = "CONNECTING";
    this.connection.dispose();
    try {
      const { url: newBaseUrl, token } = await startVm();
      this.url = newBaseUrl;
      const url3 = new URL(newBaseUrl);
      url3.searchParams.set("token", token);
      this.connection = await createWebSocketClient(url3.toString());
      this.subscribeConnection(this.connection);
      const joinResult = await this.request({
        method: "client/join",
        params: {
          clientInfo: {
            protocolVersion: version,
            appId: "sdk"
          },
          asyncProgress: false,
          subscriptions: DEFAULT_SUBSCRIPTIONS
        }
      });
      this.state = "CONNECTED";
      await this.flushMessageQueue();
      return joinResult.reconnectToken;
    } catch (error) {
      throw error;
    }
  }
  async flushMessageQueue() {
    const queuedMessages = [...this.messageQueue];
    this.messageQueue = [];
    for (const message of queuedMessages) {
      if (message.isDisposed) {
        continue;
      }
      try {
        this.connection.send(message.message);
      } catch (error) {
        message.reject(error);
      }
    }
  }
  dispose() {
    this._isDisposed = true;
    this.errorEmitter.dispose();
    this.messageEmitter.dispose();
    this.connection.dispose();
    this.disposePendingMessages();
    this.disposeQueuedMessages();
    this.pendingMessages.clear();
    this.messageQueue = [];
    this.notificationListeners = {};
  }
  disposeQueuedMessages() {
    this.messageQueue.forEach((queuedMessage) => {
      queuedMessage.dispose("Client disposed");
    });
  }
};
