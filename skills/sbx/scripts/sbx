var _BufferCtor = null;
function getBufferCtor() {
  if (!_BufferCtor) {
    if (typeof globalThis.Buffer !== "undefined") {
      _BufferCtor = globalThis.Buffer;
    } else if (typeof Buffer !== "undefined") {
      _BufferCtor = Buffer;
    } else {
      _BufferCtor = dynamicRequire("buffer", '"Buffer" is not supported: ').Buffer;
    }
  }
  return _BufferCtor;
}
function toUint8Array(data) {
  if (typeof data === "string") {
    return new TextEncoder().encode(data);
  }
  if (data instanceof ArrayBuffer) {
    return new Uint8Array(data);
  }
  if (ArrayBuffer.isView(data)) {
    return new Uint8Array(data.buffer, data.byteOffset, data.byteLength);
  }
  throw new DaytonaError("Unsupported data type for byte conversion.");
}
function concatUint8Arrays(parts2) {
  const size = parts2.reduce((sum, part) => sum + part.byteLength, 0);
  const result = new Uint8Array(size);
  let offset = 0;
  for (const part of parts2) {
    result.set(part, offset);
    offset += part.byteLength;
  }
  return result;
}
function toBuffer(data) {
  return getBufferCtor().from(data);
}
function utf8Decode(data) {
  return new TextDecoder("utf-8").decode(data);
}
function findAllBytes(buffer, pattern) {
  const results = [];
  let i = 0;
  while (i <= buffer.length - pattern.length) {
    let match = true;
    for (let j = 0; j < pattern.length; j++) {
      if (buffer[i + j] !== pattern[j]) {
        match = false;
        break;
      }
    }
    if (match) {
      results.push(i);
      i += pattern.length;
    } else {
      i++;
    }
  }
  return results;
}
function findBytesInRange(buffer, start, end, pattern) {
  let i = start;
  while (i <= end - pattern.length) {
    let match = true;
    for (let j = 0; j < pattern.length; j++) {
      if (buffer[i + j] !== pattern[j]) {
        match = false;
        break;
      }
    }
    if (match)
      return i;
    i++;
  }
  return -1;
}
function indexAfterSequence(buffer, start, sequence) {
  for (let j = 0; j < sequence.length; j++) {
    if (buffer[start + j] !== sequence[j])
      return -1;
  }
  return start + sequence.length;
}
async function collectStreamBytes(stream4) {
  if (!stream4)
    return new Uint8Array(0);
  if (typeof stream4.getReader === "function") {
    const reader = stream4.getReader();
    const chunks = [];
    try {
      while (true) {
        const { done, value: value2 } = await reader.read();
        if (done)
          break;
        if (value2?.byteLength) {
          chunks.push(value2);
        }
      }
    } finally {
      await reader.cancel();
    }
    return concatUint8Arrays(chunks);
  }
  if (stream4?.[Symbol.asyncIterator]) {
    const chunks = [];
    for await (const chunk of stream4) {
      chunks.push(toUint8Array(chunk));
    }
    return concatUint8Arrays(chunks);
  }
  if (typeof stream4 === "string" || stream4 instanceof ArrayBuffer || ArrayBuffer.isView(stream4)) {
    return toUint8Array(stream4);
  }
  if (typeof Blob !== "undefined" && stream4 instanceof Blob) {
    const arrayBuffer = await stream4.arrayBuffer();
    return new Uint8Array(arrayBuffer);
  }
  if (typeof Response !== "undefined" && stream4 instanceof Response) {
    const arrayBuffer = await stream4.arrayBuffer();
    return new Uint8Array(arrayBuffer);
  }
  throw new DaytonaError("Unsupported stream type for byte collection.");
}
function isFile2(value2) {
  const FileConstructor = globalThis.File;
  return typeof FileConstructor !== "undefined" && value2 instanceof FileConstructor;
}

// node_modules/@daytona/sdk/esm/utils/Multipart.js
function extractBoundary(contentType) {
  const match = /boundary="?([^";]+)"?/i.exec(contentType || "");
  return match ? match[1] : null;
}
function getDispositionParam(disposition, paramName) {
  const match = disposition.match(new RegExp(`${paramName}\\*?=([^;]+)`, "i"));
  if (!match)
    return void 0;
  return match[1].replace(/^"|"$/g, "").trim();
}
function parseMultipart(body, boundary) {
  const encoder = new TextEncoder();
  const dashBoundary = encoder.encode(`--${boundary}`);
  const crlf = encoder.encode("\r\n");
  const boundaryLine = concatUint8Arrays([dashBoundary, crlf]);
  const boundaryPositions = findAllBytes(body, dashBoundary);
  if (boundaryPositions.length === 0)
    return [];
  const parts2 = [];
  for (let i = 0; i < boundaryPositions.length; i++) {
    const start = boundaryPositions[i];
    const headerStart = indexAfterSequence(body, start, boundaryLine);
    if (headerStart < 0)
      continue;
    const nextBoundary = boundaryPositions[i + 1] ?? body.length;
    let partEnd = nextBoundary - 2;
    if (partEnd < headerStart)
      partEnd = headerStart;
    const separator = findBytesInRange(body, headerStart, partEnd, encoder.encode("\r\n\r\n"));
    if (separator < 0)
      continue;
    const headersText = utf8Decode(body.subarray(headerStart, separator));
    const headers = {};
    headersText.split(/\r\n/).forEach((line) => {
      const [key, ...valueParts] = line.split(":");
      if (valueParts.length > 0) {
        headers[key.trim().toLowerCase()] = valueParts.join(":").trim();
      }
    });
    const dataStart = separator + 4;
    const data = body.subarray(dataStart, partEnd);
    const disposition = headers["content-disposition"] || "";
    const name = getDispositionParam(disposition, "name");
    const filename = getDispositionParam(disposition, "filename");
    parts2.push({ name, filename, headers, data });
  }
  return parts2;
}
async function parseMultipartWithFormData(bodyBytes, contentType) {
  const result = [];
  const blob = new Blob([bodyBytes.slice()], { type: contentType });
  const formData = await new Response(blob).formData();
  const filePromises = [];
  formData.forEach((value2, fieldName) => {
    if (isFile2(value2)) {
      filePromises.push((async () => {
        const file = value2;
        const arrayBuffer = await file.arrayBuffer();
        result.push({
          fieldName,
          filename: file.name,
          contentType: file.type,
          data: new Uint8Array(arrayBuffer)
        });
      })());
    }
  });
  await Promise.all(filePromises);
  return result;
}
function getHeader(headers, key) {
  if (!headers)
    return void 0;
  const headerKey = Object.keys(headers).find((h) => h.toLowerCase() === key.toLowerCase());
  if (!headerKey)
    return void 0;
  const value2 = headers[headerKey];
  return Array.isArray(value2) ? value2[0] : value2;
}

// node_modules/@daytona/sdk/esm/utils/FileTransfer.js
function parseDownloadErrorPart(data, contentType) {
  let message = new TextDecoder("utf-8").decode(data).trim();
  if (!contentType || !/application\/json/i.test(contentType)) {
    return { message };
  }
  try {
    const payload = JSON.parse(message);
    if (!payload || typeof payload !== "object" || Array.isArray(payload)) {
      return { message };
    }
    const payloadObject = payload;
    const structuredMessage = payloadObject.message;
    const statusCode = payloadObject.statusCode ?? payloadObject.status_code;
    const code = payloadObject.code ?? payloadObject.error_code;
    const source = payloadObject.source;
    if (typeof structuredMessage === "string") {
      message = structuredMessage;
    }
    return {
      message,
      errorDetails: {
        message,
        statusCode: typeof statusCode === "number" ? statusCode : void 0,
        code: typeof code === "string" ? code : void 0,
        errorCode: typeof code === "string" ? code : void 0,
        source: typeof source === "string" ? source : void 0
      }
    };
  } catch {
    return { message };
  }
}
function assignDownloadErrorPart(metadata, data, contentType) {
  const { message, errorDetails } = parseDownloadErrorPart(data, contentType);
  metadata.error = message;
  metadata.errorDetails = errorDetails;
}
function abortStream(stream4) {
  if (stream4 && typeof stream4.destroy === "function") {
    stream4.destroy();
  } else if (stream4 && typeof stream4.cancel === "function") {
    stream4.cancel();
  }
}
function normalizeResponseStream(responseData) {
  if (!responseData || typeof responseData !== "object") {
    return responseData;
  }
  if (responseData.body && typeof responseData.body.getReader === "function") {
    return responseData.body;
  }
  if (responseData.stream) {
    return responseData.stream;
  }
  return responseData;
}
var MultipartHeaderObserver = class {
  boundary;
  closingBoundary;
  buffer = Buffer.alloc(0);
  state = "preamble";
  queue = [];
  constructor(boundary) {
    this.boundary = Buffer.from(`--${boundary}`);
    this.closingBoundary = Buffer.concat([Buffer.from("\r\n"), this.boundary]);
  }
  observe(chunk) {
    if (this.state === "done")
      return;
    this.buffer = Buffer.concat([this.buffer, chunk]);
    while (this.advance()) {
    }
  }
  /** Returns and removes the next part's Content-Length value (undefined when header was absent). */
  next() {
    return this.queue.shift();
  }
  advance() {
    switch (this.state) {
      case "preamble":
        return this.consumeBoundary(0);
      case "headers":
        return this.consumeHeaders();
      case "body":
        return this.consumeBodyToBoundary();
      default:
        return false;
    }
  }
  consumeHeaders() {
    const sepIdx = this.buffer.indexOf(HEADER_SEPARATOR);
    if (sepIdx < 0) {
      this.retainTail(HEADER_SEPARATOR.length - 1);
      return false;
    }
    this.queue.push(parseContentLength(this.buffer.subarray(0, sepIdx)));
    this.buffer = this.buffer.subarray(sepIdx + HEADER_SEPARATOR.length);
    this.state = "body";
    return true;
  }
  consumeBodyToBoundary() {
    const idx = this.buffer.indexOf(this.closingBoundary);
    if (idx < 0) {
      this.retainTail(this.closingBoundary.length - 1);
      return false;
    }
    return this.consumeBoundary(idx + 2);
  }
  // Given a buffer position at-or-after "--boundary", advance past the boundary
  // and its trailing CRLF (next part follows) or "--" (multipart terminator).
  // Returns true to drive the outer loop, false when more bytes are needed.
  consumeBoundary(searchFrom) {
    const idx = this.buffer.indexOf(this.boundary, searchFrom);
    if (idx < 0) {
      this.retainTail(this.boundary.length - 1);
      return false;
    }
    const after = idx + this.boundary.length;
    if (this.buffer.length < after + 2) {
      this.buffer = this.buffer.subarray(idx);
      return false;
    }
    if (this.buffer[after] === 45 && this.buffer[after + 1] === 45) {
      this.state = "done";
      return false;
    }
    if (this.buffer[after] === 13 && this.buffer[after + 1] === 10) {
      this.buffer = this.buffer.subarray(after + 2);
      this.state = "headers";
      return true;
    }
    return this.consumeBoundary(after);
  }
  retainTail(keep) {
    if (keep > 0 && this.buffer.length > keep) {
      this.buffer = this.buffer.subarray(this.buffer.length - keep);
    }
  }
};
var HEADER_SEPARATOR = Buffer.from("\r\n\r\n");
function parseContentLength(headersBlock) {
  const text = headersBlock.toString("latin1");
  for (const line of text.split("\r\n")) {
    const colon = line.indexOf(":");
    if (colon <= 0)
      continue;
    if (line.slice(0, colon).trim().toLowerCase() !== "content-length")
      continue;
    const value2 = Number.parseInt(line.slice(colon + 1).trim(), 10);
    return Number.isFinite(value2) && value2 >= 0 ? value2 : void 0;
  }
  return void 0;
}
async function processDownloadFilesResponseWithBusboy(stream4, headers, metadataMap, onFileStream) {
  const errPrefix = '"downloadFiles" is not supported: ';
  const busboy = dynamicRequire("busboy", errPrefix);
  const Buffer2 = dynamicRequire("buffer", errPrefix).Buffer;
  const fileTasks = [];
  const boundary = extractBoundary(getHeader(headers, "content-type") || "");
  const observer = boundary ? new MultipartHeaderObserver(boundary) : null;
  await new Promise((resolve2, reject) => {
    const bb = busboy({
      headers,
      preservePath: true
    });
    let consumerHandedOff = false;
    bb.on("file", (fieldName, fileStream, fileInfo) => {
      const totalBytes = observer?.next();
      const source = fileInfo?.filename;
      if (!source) {
        abortStream(stream4);
        reject(new DaytonaError(`Received unexpected file "${fileInfo?.filename}".`));
        return;
      }
      const metadata = metadataMap.get(source);
      if (!metadata) {
        abortStream(stream4);
        reject(new DaytonaError(`Target metadata missing for valid source: ${source}`));
        return;
      }
      if (fieldName === "error") {
        const chunks = [];
        fileStream.on("data", (chunk) => chunks.push(chunk));
        fileStream.on("end", () => {
          assignDownloadErrorPart(metadata, Buffer2.concat(chunks), fileInfo?.mimeType);
        });
        fileStream.on("error", (err2) => {
          metadata.error = `Stream error: ${err2.message}`;
        });
      } else if (fieldName === "file") {
        if (onFileStream) {
          consumerHandedOff = true;
          fileStream.on("error", () => {
            return;
          });
          onFileStream(source, fileStream, totalBytes);
        } else if (metadata.destination) {
          fileTasks.push(new Promise((resolveTask) => {
            dynamicImport("fs", "Downloading files to local files is not supported: ").then((fs2) => {
              const writeStream = fs2.createWriteStream(metadata.destination, { autoClose: true });
              fileStream.pipe(writeStream);
              writeStream.on("finish", () => {
                metadata.result = metadata.destination;
                resolveTask();
              });
              writeStream.on("error", (err2) => {
                metadata.error = `Write stream failed: ${err2.message}`;
                resolveTask();
              });
              fileStream.on("error", (err2) => {
                metadata.error = `Read stream failed: ${err2.message}`;
              });
            });
          }));
        } else {
          const chunks = [];
          fileStream.on("data", (chunk) => {
            chunks.push(Buffer2.isBuffer(chunk) ? chunk : Buffer2.from(chunk));
          });
          fileStream.on("end", () => {
            metadata.result = Buffer2.concat(chunks);
          });
          fileStream.on("error", (err2) => {
            metadata.error = `Read failed: ${err2.message}`;
          });
        }
      } else {
        fileStream.resume();
      }
    });
    bb.on("error", (err2) => {
      if (consumerHandedOff) {
        resolve2();
