function createSubscriptionId() {
  if (typeof globalThis.crypto?.randomUUID === "function") {
    return globalThis.crypto.randomUUID();
  }
  const randomHex = () => Math.floor(Math.random() * 4294967295).toString(16).padStart(8, "0");
  return `${randomHex()}${randomHex()}${randomHex()}${randomHex()}`;
}
var EventSubscriptionManager = class _EventSubscriptionManager {
  dispatcher;
  static SUBSCRIPTION_TTL = 300;
  subscriptions = /* @__PURE__ */ new Map();
  _closed = false;
  constructor(dispatcher) {
    this.dispatcher = dispatcher;
  }
  subscribe(resourceId, handler, events) {
    if (this._closed || !this.dispatcher) {
      return "";
    }
    const subId = createSubscriptionId();
    const unsubscribe = this.dispatcher.subscribe(resourceId, handler, events);
    try {
      if (this._closed) {
        throw new Error("EventSubscriptionManager is closed");
      }
      this.subscriptions.set(subId, {
        unsubscribe,
        timer: this.createTimer(subId)
      });
      return subId;
    } catch (error) {
      unsubscribe();
      if (this._closed) {
        return "";
      }
      throw error;
    }
  }
  refresh(subId) {
    if (this._closed) {
      return false;
    }
    const subscription = this.subscriptions.get(subId);
    if (!subscription) {
      return false;
    }
    clearTimeout(subscription.timer);
    subscription.timer = this.createTimer(subId);
    return true;
  }
  unsubscribe(subId) {
    const subscription = this.subscriptions.get(subId);
    if (!subscription) {
      return;
    }
    clearTimeout(subscription.timer);
    this.subscriptions.delete(subId);
    subscription.unsubscribe();
  }
  shutdown() {
    this._closed = true;
    for (const [subId, subscription] of this.subscriptions) {
      clearTimeout(subscription.timer);
      this.subscriptions.delete(subId);
      subscription.unsubscribe();
    }
  }
  createTimer(subId) {
    const timer = setTimeout(() => {
      const subscription = this.subscriptions.get(subId);
      if (!subscription || subscription.timer !== timer) {
        return;
      }
      this.subscriptions.delete(subId);
      subscription.unsubscribe();
    }, _EventSubscriptionManager.SUBSCRIPTION_TTL * 1e3);
    if (typeof timer.unref === "function") {
      timer.unref();
    }
    return timer;
  }
};

