function isServerlessRuntime() {
  const env2 = typeof process !== "undefined" ? process.env : {};
  const globalObj = globalThis;
  return Boolean(
    // Cloudflare Workers (V8 isolate API)
    typeof globalObj.WebSocketPair === "function" || // Cloudflare Pages
    env2.CF_PAGES === "1" || // AWS Lambda (incl. SAM local)
    env2.AWS_EXECUTION_ENV?.startsWith("AWS_Lambda") || env2.LAMBDA_TASK_ROOT !== void 0 || env2.AWS_SAM_LOCAL === "true" || // Azure Functions
    env2.FUNCTIONS_WORKER_RUNTIME !== void 0 || // Google Cloud Functions / Cloud Run
    env2.FUNCTION_TARGET !== void 0 && env2.FUNCTION_SIGNATURE_TYPE !== void 0 || // Vercel
    env2.VERCEL === "1" || // Netlify Functions
