var ChartType;
(function(ChartType2) {
  ChartType2["LINE"] = "line";
  ChartType2["SCATTER"] = "scatter";
  ChartType2["BAR"] = "bar";
  ChartType2["PIE"] = "pie";
  ChartType2["BOX_AND_WHISKER"] = "box_and_whisker";
  ChartType2["COMPOSITE_CHART"] = "composite_chart";
  ChartType2["UNKNOWN"] = "unknown";
})(ChartType || (ChartType = {}));
function parseChart(chart) {
  switch (chart.type) {
    case ChartType.LINE:
      return chart;
    case ChartType.SCATTER:
      return chart;
    case ChartType.BAR:
      return chart;
    case ChartType.PIE:
      return chart;
    case ChartType.BOX_AND_WHISKER:
      return chart;
    case ChartType.COMPOSITE_CHART:
      return chart;
    default:
      return chart;
  }
}

// node_modules/@daytona/sdk/esm/utils/Stream.js
function isStreamTerminationError(err2) {
  if (!err2 || typeof err2 !== "object")
    return false;
  const e = err2;
  if (e.name === "AbortError")
    return true;
  if (typeof e.message === "string" && /terminated/i.test(e.message))
    return true;
  if (e.code === "UND_ERR_SOCKET")
    return true;
  if (e.cause)
    return isStreamTerminationError(e.cause);
  return false;
}
async function processStreamingResponse(getStream, onChunk, shouldTerminate, chunkTimeout = 2e3, requireConsecutiveTermination = true) {
  const res = await getStream();
  if (!res.body)
    throw new Error("No streaming support");
  const reader = res.body.getReader();
  const decoder = new TextDecoder("utf-8");
  const TIMEOUT = Symbol();
  let exitCheckStreak = 0;
  let readPromise = null;
  try {
    while (true) {
      if (!readPromise) {
        readPromise = reader.read().then((r) => r.done ? null : r.value ?? new Uint8Array(0));
      }
      const timeoutPromise = new Promise((r) => setTimeout(() => r(TIMEOUT), chunkTimeout));
      const result = await Promise.race([readPromise, timeoutPromise]);
      if (result === TIMEOUT) {
        const stop = await shouldTerminate();
        if (stop) {
          exitCheckStreak++;
          if (!requireConsecutiveTermination || exitCheckStreak > 1) {
            try {
              await reader.cancel();
            } catch {
            }
            readPromise = null;
            break;
          }
        } else {
          exitCheckStreak = 0;
        }
      } else {
        readPromise = null;
        if (result === null) {
          break;
        }
        onChunk(decoder.decode(result, { stream: true }));
        exitCheckStreak = 0;
      }
    }
  } catch (err2) {
    if (!isStreamTerminationError(err2)) {
      throw err2;
    }
  } finally {
    const remaining = decoder.decode();
    if (remaining) {
      onChunk(remaining);
    }
    try {
      await reader.cancel();
    } catch {
    }
  }
}
function stdDemuxStream(ws, onStdout, onStderr) {
  return new Promise((resolve2, reject) => {
    if ("binaryType" in ws) {
      ws.binaryType = "arraybuffer";
    }
    const stdoutDecoder = new TextDecoder("utf-8");
    const stderrDecoder = new TextDecoder("utf-8");
    const buf = [];
    let currentDataType = null;
    const emit = (payload) => {
      if (payload.length === 0)
        return;
      if (currentDataType === "stdout") {
        const text = stdoutDecoder.decode(payload, { stream: true });
        onStdout(text);
      } else if (currentDataType === "stderr") {
        const text = stderrDecoder.decode(payload, { stream: true });
        onStderr(text);
      }
    };
    const findSubarray = (haystack, needle) => {
      if (needle.length === 0)
        return 0;
      if (haystack.length < needle.length)
        return -1;
      for (let i = 0; i <= haystack.length - needle.length; i++) {
        let found = true;
        for (let j = 0; j < needle.length; j++) {
          if (haystack[i + j] !== needle[j]) {
            found = false;
            break;
          }
        }
        if (found)
          return i;
      }
      return -1;
    };
    const handleMessage = (event) => {
      const data = event && event instanceof Object && "data" in event ? event.data : event;
      try {
        let bytes;
        if (typeof data === "string") {
          bytes = new TextEncoder().encode(data);
        } else if (data instanceof ArrayBuffer) {
          bytes = new Uint8Array(data);
        } else if (ArrayBuffer.isView(data)) {
          bytes = new Uint8Array(data.buffer, data.byteOffset, data.byteLength);
        } else if (data instanceof Blob) {
          data.arrayBuffer().then((buf2) => {
            try {
              processChunk(new Uint8Array(buf2));
            } catch (err2) {
              handleError2(err2);
            }
          }, (err2) => {
            handleError2(err2);
          });
          return;
        } else {
          throw new Error(`Unsupported message data type: ${Object.prototype.toString.call(data)}`);
        }
        processChunk(bytes);
      } catch (err2) {
        cleanup();
        try {
          ws.close();
        } catch {
        }
        reject(err2);
      }
    };
    const processChunk = (chunk) => {
      if (chunk.length === 0)
        return;
      buf.push(...chunk);
      while (true) {
        const bufArray = new Uint8Array(buf);
        let safeLen;
        if (buf.length >= MAX_PREFIX_LEN) {
          const lastByte = buf[buf.length - 1];
          if (lastByte !== 1 && lastByte !== 2) {
            safeLen = buf.length;
          } else if (buf.length >= MAX_PREFIX_LEN + 1) {
            const secondLastByte = buf[buf.length - 2];
            if (secondLastByte !== 1 && secondLastByte !== 2) {
              safeLen = buf.length - 1;
            } else {
              safeLen = buf.length - (MAX_PREFIX_LEN - 1);
            }
          } else {
            safeLen = buf.length - (MAX_PREFIX_LEN - 1);
          }
        } else {
          safeLen = buf.length - (MAX_PREFIX_LEN - 1);
        }
        if (safeLen <= 0) {
          break;
        }
        const safeRegion = bufArray.subarray(0, safeLen);
        const stdoutIndex = findSubarray(safeRegion, STDOUT_PREFIX_BYTES);
        const stderrIndex = findSubarray(safeRegion, STDERR_PREFIX_BYTES);
        let nextIdx = -1;
        let nextKind = null;
        let nextLen = 0;
        if (stdoutIndex !== -1 && (stderrIndex === -1 || stdoutIndex < stderrIndex)) {
          nextIdx = stdoutIndex;
          nextKind = "stdout";
          nextLen = STDOUT_PREFIX_BYTES.length;
        } else if (stderrIndex !== -1) {
          nextIdx = stderrIndex;
          nextKind = "stderr";
          nextLen = STDERR_PREFIX_BYTES.length;
        }
        if (nextIdx === -1) {
          const toEmit = bufArray.subarray(0, safeLen);
          emit(toEmit);
          buf.splice(0, safeLen);
          break;
        }
        if (nextIdx > 0) {
          const toEmit = bufArray.subarray(0, nextIdx);
          emit(toEmit);
        }
        buf.splice(0, nextIdx + nextLen);
        currentDataType = nextKind;
      }
    };
    const handleError2 = (error) => {
      const err2 = error && error instanceof Event ? new Error("WebSocket error") : error;
      cleanup();
      try {
        ws.close();
      } catch {
      }
      reject(err2);
    };
    const handleClose = () => {
      if (buf.length > 0 && currentDataType) {
        const remainingBytes = new Uint8Array(buf);
        if (currentDataType === "stdout") {
          const text = stdoutDecoder.decode(remainingBytes, { stream: false });
          onStdout(text);
        } else if (currentDataType === "stderr") {
          const text = stderrDecoder.decode(remainingBytes, { stream: false });
          onStderr(text);
        }
      } else {
        const stdoutFlushed = stdoutDecoder.decode();
        const stderrFlushed = stderrDecoder.decode();
        if (stdoutFlushed)
          onStdout(stdoutFlushed);
        if (stderrFlushed)
          onStderr(stderrFlushed);
      }
      cleanup();
      resolve2();
    };
    const cleanup = () => {
      if (ws.removeEventListener) {
        ws.removeEventListener("message", handleMessage);
        ws.removeEventListener("error", handleError2);
        ws.removeEventListener("close", handleClose);
      }
      if (ws.off) {
        ws.off("message", handleMessage);
        ws.off("error", handleError2);
        ws.off("close", handleClose);
      } else if (ws.removeListener) {
        ;
        ws.removeListener("message", handleMessage);
        ws.removeListener("error", handleError2);
        ws.removeListener("close", handleClose);
      }
    };
    if (ws.addEventListener) {
      ws.addEventListener("message", handleMessage);
      ws.addEventListener("error", handleError2);
      ws.addEventListener("close", handleClose);
    } else if (ws.on) {
      ws.on("message", handleMessage);
      ws.on("error", handleError2);
      ws.on("close", handleClose);
    } else {
      throw new Error("Unsupported WebSocket implementation");
    }
  });
}

