     * Gets a Sandbox by its ID or name.
     *
     * @param {string} sandboxIdOrName - The ID or name of the Sandbox to retrieve
     * @returns {Promise<Sandbox>} The Sandbox
     *
     * @example
     * const sandbox = await daytona.get('my-sandbox-id-or-name');
     * console.log(`Sandbox state: ${sandbox.state}`);
     */
    async get(sandboxIdOrName) {
      const response = await this.sandboxApi.getSandbox(sandboxIdOrName);
      const sandboxInstance = await this.ensureToolboxProxyUrl(response.data);
      return new Sandbox(sandboxInstance, structuredClone(this.clientConfig), Daytona2.createAxiosInstance(this.requestTimeoutMs), this.sandboxApi, this.getAnalyticsApiUrl, this.eventSubscriptionManager, this.requestTimeoutMs);
    }
    /**
     * Iterates over Sandboxes matching the given query.
     *
     * @param {ListSandboxesQuery} [query] - Optional filters, sorting, and per-page size.
     * @returns {AsyncIterableIterator<Sandbox>}
     *
     * @example
     * for await (const sandbox of daytona.list({ labels: { env: 'dev' } })) {
     *   console.log(sandbox.id)
     * }
     */
    list(query) {
      const { sandboxApi, clientConfig, eventSubscriptionManager, requestTimeoutMs } = this;
      const getAnalyticsApiUrl = this.getAnalyticsApiUrl;
      const ensureToolboxProxyUrl = this.ensureToolboxProxyUrl.bind(this);
      const tracer = trace.getTracer("");
      async function* generator() {
        let cursor = void 0;
        let firstPage = true;
        while (true) {
          if (!firstPage && !cursor) {
            break;
          }
          const span = tracer.startSpan("Daytona.list.fetchPage", {
            attributes: {
              component: "Daytona",
              method: "list"
            }
          }, context.active());
          let response;
          try {
            response = await context.with(trace.setSpan(context.active(), span), () => sandboxApi.listSandboxes(void 0, cursor, query?.limit, query?.id, query?.name, query?.labels ? JSON.stringify(query.labels) : void 0, void 0, void 0, query?.states, query?.snapshots, query?.targets, void 0, query?.minCpu, query?.maxCpu, query?.minMemoryGib, query?.maxMemoryGib, query?.minDiskGib, query?.maxDiskGib, query?.isPublic, query?.isRecoverable, query?.createdAtAfter, query?.createdAtBefore, query?.lastActivityAfter, query?.lastActivityBefore, query?.autoDestroyAtAfter, query?.autoDestroyAtBefore, query?.sort, query?.order));
            span.setStatus({ code: SpanStatusCode.OK });
          } catch (error) {
            span.setStatus({
              code: SpanStatusCode.ERROR,
              message: error instanceof Error ? error.message : String(error)
            });
            span.recordException(error instanceof Error ? error : new Error(String(error)));
            throw error;
          } finally {
            span.end();
          }
          firstPage = false;
          for (const sandbox of response.data.items) {
            const hydratedSandbox = await ensureToolboxProxyUrl(sandbox);
            yield new Sandbox(hydratedSandbox, structuredClone(clientConfig), Daytona2.createAxiosInstance(requestTimeoutMs), sandboxApi, getAnalyticsApiUrl, eventSubscriptionManager, requestTimeoutMs);
          }
          cursor = response.data.nextCursor ?? void 0;
          if (!cursor) {
            break;
          }
        }
      }
      return generator();
    }
    async ensureToolboxProxyUrl(sandboxDto) {
      if (sandboxDto.toolboxProxyUrl) {
        return sandboxDto;
      }
      const proxyUrl = await this.sandboxApi.getToolboxProxyUrl(sandboxDto.id);
      return {
        ...sandboxDto,
        toolboxProxyUrl: proxyUrl.data.url
      };
    }
    /**
     * Starts a Sandbox and waits for it to be ready.
     *
     * @param {Sandbox} sandbox - The Sandbox to start
     * @param {number} [timeout] - Optional timeout in seconds (0 means no timeout)
     * @returns {Promise<void>}
     *
     * @example
     * const sandbox = await daytona.get('my-sandbox-id');
     * // Wait up to 60 seconds for the sandbox to start
     * await daytona.start(sandbox, 60);
     */
    async start(sandbox, timeout) {
      await sandbox.start(timeout);
    }
    /**
     * Stops a Sandbox.
     *
     * @param {Sandbox} sandbox - The Sandbox to stop
     * @returns {Promise<void>}
     *
     * @example
     * const sandbox = await daytona.get('my-sandbox-id');
     * await daytona.stop(sandbox);
     */
    async stop(sandbox) {
      await sandbox.stop();
    }
    /**
     * Forks a Sandbox, creating a new Sandbox with an identical filesystem.
     *
     * @param {Sandbox} sandbox - The Sandbox to fork
     * @param {ForkSandboxParams} [params] - Fork parameters
     * @param {string} [params.name] - Optional name for the forked Sandbox
     * @param {number} [timeout] - Timeout in seconds (0 means no timeout, default is 60)
     * @returns {Promise<Sandbox>} The forked Sandbox
     *
     * @example
     * const sandbox = await daytona.get('my-sandbox-id');
     * const forked = await daytona.fork(sandbox, { name: 'my-fork' });
     * console.log(`Forked sandbox: ${forked.id}`);
     */
    async fork(sandbox, params, timeout = 60) {
      return await sandbox.fork(params, timeout);
    }
    /**
     * @deprecated Use `fork` instead. This method will be removed in a future version.
     * @see {@link Daytona.fork}
     */
    async _experimental_fork(sandbox, params, timeout = 60) {
      return this.fork(sandbox, params, timeout);
    }
    /**
     * Deletes a Sandbox.
     *
     * @param {Sandbox} sandbox - The Sandbox to delete
     * @param {number} timeout - Timeout in seconds (0 means no timeout, default is 60)
     * @param {boolean} wait - If true, wait until the Sandbox is destroyed (default is false)
     * @returns {Promise<void>}
     *
     * @example
     * const sandbox = await daytona.get('my-sandbox-id');
     * await daytona.delete(sandbox);
     */
    async delete(sandbox, timeout = 60, wait = false) {
      await sandbox.delete(timeout, wait);
    }
    /**
     * @hidden
     */
    static createAxiosInstance(requestTimeoutMs) {
      const axiosInstance = axios_default.create({
        timeout: requestTimeoutMs ?? DEFAULT_REQUEST_TIMEOUT_MS,
        // Cloudflare Workers' runtime rejects the `cache: 'default'` that axios'
        // fetch adapter would otherwise apply, so set a mode workerd accepts.
        // Ignored by the Node http adapter. API responses are not cacheable anyway.
        fetchOptions: { cache: "no-store" }
      });
      axiosInstance.interceptors.request.use((requestConfig) => {
        const currentContext = context.active();
        propagation.inject(currentContext, requestConfig.headers);
        requestConfig.metadata = { startTime: Date.now() };
        return requestConfig;
      }, (error) => {
        return Promise.reject(error);
      });
      axiosInstance.interceptors.response.use((response) => {
        return response;
      }, (error) => {
        if (error instanceof AxiosError2) {
          throw createAxiosDaytonaError(error);
        }
        throw new DaytonaError(error instanceof Error ? error.message : String(error));
      });
      axiosInstance.interceptors.response.use((response) => {
        const startTime = response.config.metadata?.startTime;
        if (startTime) {
          const duration = Date.now() - startTime;
          const activeSpan = trace.getActiveSpan();
          if (activeSpan && activeSpan.isRecording()) {
            activeSpan.setAttributes({
              "http.response.status_code": response.status,
              "http.response.duration_ms": duration
              // 'http.response.size_bytes': JSON.stringify(response.data).length,
            });
          }
        }
        return response;
      }, (error) => {
        const startTime = error.config?.metadata?.startTime;
        if (startTime) {
          const duration = Date.now() - startTime;
          const activeSpan = trace.getActiveSpan();
          if (activeSpan && activeSpan.isRecording()) {
            activeSpan.setStatus({
              code: SpanStatusCode.ERROR,
              message: error.message
            });
            activeSpan.setAttributes({
              "http.response.duration_ms": duration,
              "error.type": error.name,
              "error.message": error.message
            });
            if (error.response) {
              activeSpan.setAttribute("http.response.status_code", error.response.status);
            }
            activeSpan.recordException(error);
          }
        }
        return Promise.reject(error);
      });
      return axiosInstance;
    }
  };
})();

// node_modules/@daytona/sdk/esm/index.js
var import_api_client4 = __toESM(require_src3(), 1);

// node_modules/@xyzensun/sbx/dist/dockerfile/parser.js
import { access, readFile } from "node:fs/promises";
async function assertFileReadable(path2) {
  try {
    await access(path2);
  } catch {
    throw new SbxError("CLI_USAGE", `Dockerfile not found: ${path2}`);
  }
}
async function parseSingleStageDockerfile(path2) {
  await assertFileReadable(path2);
  const content = await readFile(path2, "utf-8");
  const logicalLines = [];
  let pending = "";
  for (const rawLine of content.split(/\r?\n/)) {
    const line = pending + rawLine;
    if (line.trimEnd().endsWith("\\")) {
      pending = line.trimEnd().slice(0, -1) + " ";
      continue;
    }
    pending = "";
    logicalLines.push(line);
  }
  const fromLines = [];
  logicalLines.forEach((line, index) => {
    const trimmed = line.trim();
    if (trimmed.length === 0 || trimmed.startsWith("#")) {
      return;
    }
    const fromMatch = /^FROM\s+(?:--platform=\S+\s+)?(\S+)(?:\s+AS\s+\S+)?$/i.exec(trimmed);
    if (fromMatch) {
      fromLines.push({ lineNo: index + 1, image: fromMatch[1] });
    }
  });
  if (fromLines.length === 0) {
    throw new SbxError("DOCKERFILE_INVALID", `Dockerfile "${path2}" contains no FROM instruction; a valid single-stage build must start with one FROM`);
  }
  if (fromLines.length > 1) {
    const locations = fromLines.map((f) => `line ${f.lineNo} (FROM ${f.image})`).join(", ");
    throw new SbxError("DOCKERFILE_INVALID", `Dockerfile "${path2}" is multi-stage (found ${fromLines.length} FROM instructions: ${locations}). Only single-stage builds are supported; merge the stages or pre-build the artifact and COPY it in`);
  }
  return { baseImage: fromLines[0].image, content };
}

// node_modules/@xyzensun/sbx/dist/template-naming.js
import { createHash } from "node:crypto";
async function nameTemplate(source) {
  if (source.kind === "dockerfile") {
    const parsed = await parseSingleStageDockerfile(source.path);
    const hash = contentHash(parsed.content);
    const name = `sbx-${slugify(parsed.baseImage)}-${hash}`;
    return {
      name,
      description: `dockerfile ${source.path} (base: ${parsed.baseImage}) \u2192 template "${name}"`
    };
  }
  if (source.kind === "image") {
    const normalized = source.image.toLowerCase();
    const hash = contentHash(normalized);
    const name = `sbx-${slugify(normalized)}-${hash}`;
    return {
      name,
      description: `image ${source.image} \u2192 template "${name}"`
    };
  }
  return null;
}
function contentHash(content) {
  return createHash("sha256").update(content).digest("hex").slice(0, 8);
}
function slugify(ref) {
  const slug = ref.toLowerCase().replace(/[/@:.]+/g, "-").replace(/[^a-z0-9_-]+/g, "-").replace(/-{2,}/g, "-").replace(/^-+|-+$/g, "");
  return slug || "base";
}

// node_modules/@xyzensun/sbx/dist/providers/daytona-provider.js
var API_KEY_ENV = "DAYTONA_API_KEY";
var SESSION_ID = "sbx-cli";
var DaytonaProvider = class {
  platform = "daytona";
  displayName = "Daytona";
  apiKeyEnvName = API_KEY_ENV;
  daytona;
  constructor() {
    if (!process.env[API_KEY_ENV]) {
      throw new SbxError("MISSING_API_KEY", `Environment variable ${API_KEY_ENV} is not set`);
    }
    const config = { apiKey: process.env[API_KEY_ENV] };
    if (process.env.DAYTONA_API_URL) {
      config.apiUrl = process.env.DAYTONA_API_URL;
    }
    this.daytona = new Daytona(config);
  }
  isConfigured() {
    return Boolean(process.env[API_KEY_ENV]);
  }
  async createSandbox(params) {
    const { source, ttlMinutes, envVars } = params;
    let createParams;
    let sourceDescription;
    if (source.kind === "template") {
      createParams = { snapshot: source.template };
      sourceDescription = `snapshot: ${source.template}`;
    } else if (source.kind === "image") {
      createParams = { image: source.image };
      sourceDescription = `image: ${source.image}`;
    } else if (source.kind === "dockerfile") {
      const parsed = await parseSingleStageDockerfile(source.path);
      const naming = await nameTemplate(source);
      const snapshotName = naming.name;
      await this.buildSnapshotWithCache(source.path, snapshotName, params.forceRebuild ?? false);
      createParams = { snapshot: snapshotName };
      sourceDescription = naming.description;
    } else {
      createParams = {};
      sourceDescription = "daytona-small (default snapshot)";
    }
    if (envVars) {
      createParams.envVars = envVars;
    }
    if (ttlMinutes > 0) {
      createParams.autoDeleteInterval = ttlMinutes;
    }
    const sandbox = await this.daytona.create(createParams);
    return {
      sandboxId: sandbox.id,
      platform: this.platform,
      sourceDescription
    };
  }
  /**
   * 幂等确保 session 存在：session 不存在时 executeSessionCommand 会报
   * "session not found"。已存在时 getSession 成功，直接复用。
   */
  async ensureSession(sandbox) {
    try {
      await sandbox.process.getSession(SESSION_ID);
    } catch {
      await sandbox.process.createSession(SESSION_ID);
    }
  }
  async runCommand(params) {
    const { sandboxId, command, cwd: cwd2, env: env2, timeoutSeconds, background, onStdout, onStderr } = params;
    const sandbox = await this.daytona.get(sandboxId);
    await this.ensureSession(sandbox);
    const effectiveCommand = composeSessionCommand(command, cwd2, env2);
    const response = await sandbox.process.executeSessionCommand(SESSION_ID, { command: effectiveCommand, runAsync: background }, timeoutSeconds);
    if (background) {
      return {
        commandId: response.cmdId,
        stdout: "",
        stderr: "",
        exitCode: null,
        status: "running"
      };
    }
    const stdout = response.stdout ?? "";
    const stderr = response.stderr ?? "";
    const exitCode = response.exitCode ?? null;
    if (onStdout && stdout)
      onStdout(stdout);
    if (onStderr && stderr)
      onStderr(stderr);
    return {
      commandId: response.cmdId,
      stdout,
      stderr,
      exitCode,
      status: exitCode === 0 ? "finished" : "failed"
    };
  }
  async getCommandResult(sandboxId, commandId) {
    const sandbox = await this.daytona.get(sandboxId);
    await this.ensureSession(sandbox);
    const command = await sandbox.process.getSessionCommand(SESSION_ID, commandId);
    const logs = await sandbox.process.getSessionCommandLogs(SESSION_ID, commandId);
    const exitCode = command.exitCode ?? null;
    return {
      commandId,
      stdout: logs.stdout ?? "",
      stderr: logs.stderr ?? "",
      exitCode,
      status: exitCode == null ? "running" : exitCode === 0 ? "finished" : "failed"
    };
  }
  async uploadFile(sandboxId, localPath, remotePath) {
    const sandbox = await this.daytona.get(sandboxId);
    await sandbox.fs.uploadFile(localPath, remotePath);
  }
  async downloadFile(sandboxId, remotePath, localPath) {
    const sandbox = await this.daytona.get(sandboxId);
    const buffer = await sandbox.fs.downloadFile(remotePath);
    await mkdir(dirname2(localPath), { recursive: true });
    await writeFile(localPath, buffer);
  }
  async getPreviewUrl(sandboxId, port) {
    const sandbox = await this.daytona.get(sandboxId);
    const signed = await sandbox.getSignedPreviewUrl(port, 3600);
    return signed.url;
  }
  async listSandboxes() {
    const items = [];
    for await (const sbx of this.daytona.list()) {
      items.push({
        sandboxId: sbx.id,
        platform: this.platform,
        state: sbx.state ?? "unknown"
      });
    }
    return items;
  }
  async stopSandbox(sandboxId) {
    const sandbox = await this.daytona.get(sandboxId);
    await sandbox.stop();
  }
  async destroySandbox(sandboxId) {
    const sandbox = await this.daytona.get(sandboxId);
    await sandbox.delete();
  }
  /**
   * Dockerfile → Daytona snapshot（构建在 Daytona 云端）+ 按 name 缓存。
   * 设计意图：snapshot 构建是分钟级操作；内容寻址命名（sbx-<base>-<hash8>）
   * 让同一 Dockerfile 只构建一次。--force-rebuild 时先删旧再建。
   */
  async buildSnapshotWithCache(dockerfilePath, snapshotName, forceRebuild) {
    if (!forceRebuild) {
      try {
        const existing = await this.daytona.snapshot.get(snapshotName);
        if (existing) {
          return existing.name ?? snapshotName;
        }
      } catch {
      }
    }
    const image = Image.fromDockerfile(dockerfilePath);
    const snapshot = await this.daytona.snapshot.create({ name: snapshotName, image });
    return snapshot.name ?? snapshotName;
  }
};
function composeSessionCommand(command, cwd2, env2) {
  const parts2 = [];
  if (cwd2) {
    parts2.push(`cd ${shellQuote(cwd2)} || exit 1`);
  }
  if (env2 && Object.keys(env2).length > 0) {
    const exports = Object.entries(env2).map(([key, value2]) => `${shellEscapeKey(key)}=${shellQuote(String(value2))}`).join(" ");
    parts2.push(`export ${exports}`);
  }
  parts2.push(command);
  return parts2.join(" && ");
}
function shellQuote(value2) {
  return `'${value2.replace(/'/g, `'\\''`)}'`;
}
function shellEscapeKey(key) {
  if (!/^[A-Za-z_][A-Za-z0-9_]*$/.test(key)) {
    throw new SbxError("CLI_USAGE", `Invalid environment variable name: ${key}`);
  }
  return key;
}

// node_modules/@xyzensun/sbx/dist/providers/e2b-provider.js
var import_e2b = __toESM(require_dist3(), 1);
import { mkdir as mkdir2, writeFile as writeFile2, readFile as readFile2 } from "node:fs/promises";
import { dirname as dirname3 } from "node:path";
var API_KEY_ENV2 = "E2B_API_KEY";
var E2BProvider = class {
  platform = "e2b";
  displayName = "E2B";
  apiKeyEnvName = API_KEY_ENV2;
  client;
  constructor() {
    if (!process.env[API_KEY_ENV2]) {
      throw new SbxError("MISSING_API_KEY", `Environment variable ${API_KEY_ENV2} is not set`);
    }
    this.client = new import_e2b.E2B();
  }
  isConfigured() {
    return Boolean(process.env[API_KEY_ENV2]);
  }
  async createSandbox(params) {
    const { source, ttlMinutes, envVars } = params;
    const timeoutMs = Math.min(ttlMinutes, 60) * 60 * 1e3;
    let template;
    let sourceDescription = "base (default template)";
    if (source.kind === "template") {
      template = source.template;
      sourceDescription = `template: ${source.template}`;
    } else if (source.kind === "dockerfile" || source.kind === "image") {
      const naming = await nameTemplate(source);
      template = await this.buildTemplateWithCache(source, naming.name, params.forceRebuild ?? false);
      sourceDescription = naming.description;
    }
    const sandbox = await this.client.Sandbox.create({
      template,
      envs: envVars,
      // 超时即销毁（kill），与 CLI 的 TTL 语义保持一致
      timeoutMs
    });
    return {
      sandboxId: sandbox.sandboxId,
      platform: this.platform,
      sourceDescription
    };
  }
  async runCommand(params) {
    const { sandboxId, command, cwd: cwd2, env: env2, timeoutSeconds, background, onStdout, onStderr } = params;
    const sandbox = await this.client.Sandbox.connect(sandboxId);
    if (background) {
      const handle = await sandbox.commands.run(command, {
        cwd: cwd2,
        envs: env2,
        timeoutMs: timeoutSeconds * 1e3,
        background: true
      });
      return {
        commandId: String(handle.pid),
        stdout: "",
        stderr: "",
        exitCode: null,
        status: "running"
      };
    }
    let result;
    try {
      result = await sandbox.commands.run(command, {
        cwd: cwd2,
        envs: env2,
        timeoutMs: timeoutSeconds * 1e3,
        onStdout,
        onStderr
      });
    } catch (error) {
      if (error instanceof import_e2b.CommandExitError) {
        result = error;
      } else {
        throw error;
      }
    }
    return {
      // 同步模式无独立句柄 ID：标记为一次性命令（不可再查询，语义与 --background 区分）
      commandId: "sync",
      stdout: result.stdout,
      stderr: result.stderr,
      exitCode: result.exitCode,
      status: result.exitCode === 0 ? "finished" : "failed"
    };
  }
  async getCommandResult(sandboxId, commandId) {
    const sandbox = await this.client.Sandbox.connect(sandboxId);
    const handle = await sandbox.commands.connect(Number(commandId));
    let result;
    try {
      result = await handle.wait();
    } catch (error) {
      if (error instanceof import_e2b.CommandExitError) {
        result = error;
      } else {
        throw error;
      }
    }
    return {
      commandId,
      stdout: result.stdout,
      stderr: result.stderr,
      exitCode: result.exitCode,
      status: result.exitCode === 0 ? "finished" : "failed"
    };
  }
  async uploadFile(sandboxId, localPath, remotePath) {
    const sandbox = await this.client.Sandbox.connect(sandboxId);
    const bytes = await readFile2(localPath);
    const arrayBuffer = bytes.buffer.slice(bytes.byteOffset, bytes.byteOffset + bytes.byteLength);
    await sandbox.files.write(remotePath, arrayBuffer);
  }
  async downloadFile(sandboxId, remotePath, localPath) {
    const sandbox = await this.client.Sandbox.connect(sandboxId);
    const bytes = await sandbox.files.read(remotePath, { format: "bytes" });
    await mkdir2(dirname3(localPath), { recursive: true });
    await writeFile2(localPath, bytes);
  }
  async getPreviewUrl(sandboxId, port) {
    const sandbox = await this.client.Sandbox.connect(sandboxId);
    return `https://${sandbox.getHost(port)}`;
  }
  async listSandboxes() {
    const paginator = this.client.Sandbox.list();
    const items = [];
    while (paginator.hasNext) {
      for (const info of await paginator.nextItems()) {
        items.push({
          sandboxId: info.sandboxId,
          platform: this.platform,
          state: info.state,
          createdAt: info.startedAt?.toISOString()
        });
      }
    }
    return items;
  }
  async stopSandbox(sandboxId) {
    const sandbox = await this.client.Sandbox.connect(sandboxId);
    await sandbox.pause();
  }
  async destroySandbox(sandboxId) {
    await this.client.Sandbox.kill(sandboxId);
  }
  /**
   * E2B 模板构建 + 缓存：同名模板存在则直接复用。
   * 设计意图：构建是分钟级操作，内容寻址命名让同一 Dockerfile/镜像
   * 只构建一次；--force-rebuild 走 skipCache 让平台全量重建。
   */
  async buildTemplateWithCache(source, cacheName, forceRebuild) {
    if (!forceRebuild) {
      try {
        const exists = await this.client.Template.exists(cacheName);
        if (exists) {
          return cacheName;
        }
      } catch {
      }
    }
    const builder = source.kind === "dockerfile" ? (0, import_e2b.Template)().fromDockerfile(source.path) : (0, import_e2b.Template)().fromImage(source.image);
    await this.client.Template.build(builder, cacheName, forceRebuild ? { skipCache: true } : void 0);
    return cacheName;
  }
};

// node_modules/@xyzensun/sbx/dist/providers/codesandbox-provider.js
import { mkdir as mkdir3, writeFile as writeFile3, readFile as readFile4 } from "node:fs/promises";
import { dirname as dirname4 } from "node:path";

// node_modules/@codesandbox/sdk/dist/esm/index.js
import { createRequire as createRequire2 } from "module";

// node_modules/fflate/esm/index.mjs
import { createRequire } from "module";
