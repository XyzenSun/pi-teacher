// node_modules/@daytona/sdk/esm/CodeInterpreter.js
var import_isomorphic_ws3 = __toESM(require_node2(), 1);
var WEBSOCKET_TIMEOUT_CODE = 4008;
var CodeInterpreter = class {
  clientConfig;
  apiClient;
  getPreviewToken;
  constructor(clientConfig, apiClient, getPreviewToken) {
    this.clientConfig = clientConfig;
    this.apiClient = apiClient;
    this.getPreviewToken = getPreviewToken;
  }
  /**
   * Run Python code in the sandbox.
   *
   * @param {string} code - Code to run.
   * @param {RunCodeOptions} options - Execution options (context, envs, callbacks, timeout).
   * @returns {Promise<ExecutionResult>} ExecutionResult containing stdout, stderr and optional error info.
   *
   * @example
   * ```ts
   * const handleStdout = (msg: OutputMessage) => process.stdout.write(`STDOUT: ${msg.output}`)
   * const handleStderr = (msg: OutputMessage) => process.stdout.write(`STDERR: ${msg.output}`)
   * const handleError = (err: ExecutionError) =>
   *   console.error(`ERROR: ${err.name}: ${err.value}\n${err.traceback ?? ''}`)
   *
   * const code = `
   * import sys
   * import time
   * for i in range(5):
   *     print(i)
   *     time.sleep(1)
   * sys.stderr.write("Counting done!")
   * `
   *
   * const result = await codeInterpreter.runCode(code, {
   *   onStdout: handleStdout,
   *   onStderr: handleStderr,
   *   onError: handleError,
   *   timeout: 10,
   * })
   * ```
   */
  async runCode(code, options = {}) {
    if (!code || !code.trim()) {
      throw new DaytonaInvalidArgumentError("Code is required for execution");
    }
    const url3 = `${this.clientConfig.basePath.replace(/^http/, "ws")}/process/interpreter/execute`;
    const ws = await createSandboxWebSocket(url3, this.clientConfig.baseOptions?.headers || {}, this.getPreviewToken);
    const result = { stdout: "", stderr: "" };
    return new Promise((resolve2, reject) => {
      let settled = false;
      const cleanup = () => {
        detach();
        try {
          if (ws.readyState === import_isomorphic_ws3.default.OPEN || ws.readyState === import_isomorphic_ws3.default.CONNECTING) {
            ws.close();
          }
        } catch {
        }
      };
      const fail = (error) => {
        if (settled)
          return;
        settled = true;
        cleanup();
        reject(error);
      };
      const succeed = () => {
        if (settled)
          return;
        settled = true;
        cleanup();
        resolve2(result);
      };
      const handleOpen = () => {
        const payload = { code };
        const context2 = options.context;
        if (context2?.id) {
          payload.contextId = context2.id;
        }
        if (options.envs) {
          payload.envs = options.envs;
        }
        payload.timeout = options.timeout;
        ws.send(JSON.stringify(payload));
      };
      const handleMessage = async (event) => {
        try {
          const text = await this.extractMessageText(event);
          if (!text) {
            return;
          }
          const chunk = JSON.parse(text);
          const chunkType = chunk.type;
          if (chunkType === "stdout") {
            const stdout = chunk.text ?? "";
            result.stdout += stdout;
            if (options.onStdout) {
              await options.onStdout({ output: stdout });
            }
          } else if (chunkType === "stderr") {
            const stderr = chunk.text ?? "";
            result.stderr += stderr;
            if (options.onStderr) {
              await options.onStderr({ output: stderr });
            }
          } else if (chunkType === "error") {
            const error = {
              name: chunk.name ?? "",
              value: chunk.value ?? "",
              traceback: chunk.traceback ?? ""
            };
            result.error = error;
            if (options.onError) {
              await options.onError(error);
            }
          } else if (chunkType === "control") {
            const controlText = chunk.text ?? "";
            if (controlText === "completed" || controlText === "interrupted") {
              succeed();
            }
          }
        } catch {
        }
      };
      const handleClose = (event, reason) => {
        if (settled)
          return;
        const { code: code2, message } = this.normalizeCloseEvent(event, reason);
        if (code2 !== 1e3 && code2 !== 1001) {
          fail(this.createCloseError(code2, message));
          return;
        }
        succeed();
      };
      const handleError2 = (error) => {
        fail(new DaytonaConnectionError(`Failed to execute code: ${error.message ?? String(error)}`));
      };
      const detach = () => {
        if ("removeEventListener" in ws) {
          ws.removeEventListener("open", handleOpen);
          ws.removeEventListener("message", handleMessage);
          ws.removeEventListener("close", handleClose);
          ws.removeEventListener("error", handleError2);
        }
        if ("off" in ws) {
          ;
          ws.off("open", handleOpen);
          ws.off("message", handleMessage);
          ws.off("close", handleClose);
          ws.off("error", handleError2);
        } else if ("removeListener" in ws) {
          ;
          ws.removeListener("open", handleOpen);
          ws.removeListener("message", handleMessage);
          ws.removeListener("close", handleClose);
          ws.removeListener("error", handleError2);
        }
      };
      if ("addEventListener" in ws) {
        ws.addEventListener("open", handleOpen);
        ws.addEventListener("message", handleMessage);
        ws.addEventListener("close", handleClose);
        ws.addEventListener("error", handleError2);
      } else if ("on" in ws) {
        ;
        ws.on("open", handleOpen);
        ws.on("message", handleMessage);
        ws.on("close", handleClose);
        ws.on("error", handleError2);
      } else {
        throw new DaytonaError("Unsupported WebSocket implementation");
      }
    });
  }
  /**
   * Create a new isolated interpreter context.
   *
   * @param {string} [cwd] - Working directory for the context. Uses sandbox working directory if omitted.
   *
   * @returns {Promise<InterpreterContext>} The created context.
   *
   * @example
   * ```ts
   * const ctx = await sandbox.codeInterpreter.createContext()
   * await sandbox.codeInterpreter.runCode('x = 10', { context: ctx })
   * await sandbox.codeInterpreter.deleteContext(ctx.id!)
   * ```
   */
  async createContext(cwd2) {
    return (await this.apiClient.createInterpreterContext({ cwd: cwd2 })).data;
  }
  /**
   * List all user-created interpreter contexts (default context is excluded).
   *
   * @returns {Promise<InterpreterContext[]>} List of contexts.
   *
   * @example
   * ```ts
   * const contexts = await sandbox.codeInterpreter.listContexts()
   * for (const ctx of contexts) {
   *   console.log(ctx.id, ctx.language, ctx.cwd)
   * }
   * ```
   */
  async listContexts() {
    return (await this.apiClient.listInterpreterContexts()).data.contexts ?? [];
  }
  /**
   * Delete an interpreter context and shut down its worker process.
   *
   * @param {InterpreterContext} context - Context to delete.
   *
   * @example
   * ```ts
   * const ctx = await sandbox.codeInterpreter.createContext()
   * // ... use context ...
   * await sandbox.codeInterpreter.deleteContext(ctx)
   * ```
   */
  async deleteContext(context2) {
    await this.apiClient.deleteInterpreterContext(context2.id);
  }
  async extractMessageText(event) {
    const data = event && typeof event === "object" && "data" in event ? event.data : event;
    if (typeof data === "string") {
      return data;
    }
    if (typeof ArrayBuffer !== "undefined" && data instanceof ArrayBuffer) {
      return new TextDecoder("utf-8").decode(new Uint8Array(data));
    }
    if (typeof Blob !== "undefined" && data instanceof Blob) {
      return await data.text();
    }
    if (ArrayBuffer.isView(data)) {
      return new TextDecoder("utf-8").decode(new Uint8Array(data.buffer, data.byteOffset, data.byteLength));
    }
    if (data == null) {
      return "";
    }
    return data.toString();
  }
  normalizeCloseEvent(event, reason) {
    if (typeof event === "number") {
      return {
        code: event,
        message: reason ? reason.toString("utf-8") : ""
      };
    }
    return {
      code: event.code,
      message: event.reason
    };
  }
  createCloseError(code, message) {
    if (code === WEBSOCKET_TIMEOUT_CODE) {
      return new DaytonaTimeoutError("Execution timed out: operation exceeded the configured `timeout`. Provide a larger value if needed.");
    }
    if (message) {
      return new DaytonaConnectionError(message + ` (close code ${code})`);
    }
    return new DaytonaConnectionError(`Code execution failed: WebSocket closed with code ${code}`);
  }
};

// node_modules/@daytona/sdk/esm/utils/fileUrlSigning.js
import { createHmac } from "crypto";
var SIGNATURE_V1_PREFIX = "v1_";
var DEFAULT_TTL_SECONDS = 3600;
function computeFileUrlSignature(signingKey, method, path2, expires) {
  const canonical = `v1:files:${method}:${path2}:${expires}`;
  const digest = createHmac("sha256", signingKey).update(canonical).digest("base64url");
  return `${SIGNATURE_V1_PREFIX}${digest}`;
}
function resolveExpires(ttlSeconds) {
  if (ttlSeconds === void 0) {
    return Math.floor(Date.now() / 1e3) + DEFAULT_TTL_SECONDS;
  }
  if (!Number.isFinite(ttlSeconds)) {
    throw new DaytonaError("ttlSeconds must be a finite number");
  }
  if (ttlSeconds <= 0) {
    return 0;
  }
  return Math.floor(Date.now() / 1e3) + Math.floor(ttlSeconds);
}
function buildSignedFileUrl(toolboxProxyUrl, sandboxId, operationPath, method, filePath, signingKey, ttlSeconds) {
  if (!signingKey) {
    throw new DaytonaError("Sandbox signing key is not available. Call refreshData() or fetch the sandbox by ID to load it.");
  }
  if (!toolboxProxyUrl) {
    throw new DaytonaError("Sandbox toolbox proxy URL is not available. Call refreshData() or fetch the sandbox by ID to load it.");
  }
  const expires = resolveExpires(ttlSeconds);
  const signature = computeFileUrlSignature(signingKey, method, filePath, expires);
  const query = new URLSearchParams({
    path: filePath,
    expires: String(expires),
    signature
  });
  return `${toolboxProxyUrl.replace(/\/+$/, "")}/${sandboxId}${operationPath}?${query.toString()}`;
}

