var executionHistograms = /* @__PURE__ */ new Map();
function toSnakeCase(str) {
  return str.replace(/([A-Z])/g, "_$1").toLowerCase().replace(/^_/, "").replace(/\./g, "_");
}
function WithSpan(config) {
  return function(originalMethod, context2) {
    const methodName = String(context2.name);
    return async function(...args) {
      const cfg = typeof config === "string" ? { name: config } : config || {};
      const { name, attributes = {} } = cfg;
      const className = this?.constructor?.name ?? "Anonymous";
      const spanName = name || `${className}.${methodName}`;
      const allAttributes = {
        component: className,
        method: methodName,
        ...attributes
      };
      const span = getTracer().startSpan(spanName, { attributes: allAttributes }, context.active());
      return context.with(trace.setSpan(context.active(), span), async () => {
        try {
          const result = await originalMethod.apply(this, args);
          span.setStatus({ code: SpanStatusCode.OK });
          return result;
        } catch (error) {
          span.setStatus({
            code: SpanStatusCode.ERROR,
            message: error instanceof Error ? error.message : String(error)
          });
          span.recordException(error instanceof Error ? error : new Error(String(error)));
          throw error;
        } finally {
          span.end();
        }
      });
    };
  };
}
function WithMetric(config) {
  return function(originalMethod, context2) {
    const methodName = String(context2.name);
    return async function(...args) {
      const cfg = typeof config === "string" ? { name: config } : config || {};
      const { name, description, labels = {} } = cfg;
      const className = this?.constructor?.name ?? "Anonymous";
      const metricName = toSnakeCase(name || `${className}.${methodName}`);
      const allLabels = {
        component: className,
        method: methodName,
        ...labels
      };
      if (!executionHistograms.has(metricName)) {
        executionHistograms.set(metricName, getMeter().createHistogram(`${metricName}_duration`, {
          description: description || `Duration of executions for ${metricName}`,
          unit: "ms"
        }));
      }
      const histogram = executionHistograms.get(metricName);
      if (!histogram) {
        throw new Error(`Histogram not found for metric: ${metricName}`);
      }
      const startTime = Date.now();
      let status = "success";
      try {
        const result = await originalMethod.apply(this, args);
        return result;
      } catch (error) {
        status = "error";
        throw error;
      } finally {
        const duration = Date.now() - startTime;
        histogram.record(duration, { ...allLabels, status });
      }
    };
  };
}
function WithInstrumentation(config) {
  const cfg = typeof config === "string" ? { name: config } : config || {};
  const { enableTraces = true, enableMetrics = true, name, description, labels } = cfg;
  return function(originalMethod, context2) {
    let wrapped = originalMethod;
    if (enableTraces) {
      wrapped = WithSpan({ name, attributes: labels })(wrapped, context2);
    }
    if (enableMetrics) {
      wrapped = WithMetric({ name, description, labels })(wrapped, context2);
    }
    return wrapped;
  };
}

