function parseStreamEvent(evt) {
  if (typeof evt !== "string") {
    return evt;
  }
  const evtWithoutDataPrefix = evt.substring(5);
  return JSON.parse(evtWithoutDataPrefix);
}
var PintShellsClient = class {
  constructor(apiClient, sandboxId) {
    this.apiClient = apiClient;
    this.sandboxId = sandboxId;
    this.openShells = {};
    this.onShellExitedEmitter = new EmitterSubscription(
      (fire) => this.subscribeAndEvaluateExecsUpdates((exec, prevExec) => {
        if (!prevExec) {
          return;
        }
        if (prevExec.status === "RUNNING" && exec.status === "EXITED") {
          fire({
            shellId: exec.id,
            exitCode: exec.exitCode
          });
        }
      })
    );
    this.onShellExited = this.onShellExitedEmitter.event;
    this.onShellOutEmitter = new Emitter7();
    this.onShellOut = this.onShellOutEmitter.event;
    this.onShellTerminatedEmitter = new EmitterSubscription(
      (fire) => this.subscribeAndEvaluateExecsUpdates((exec, prevExec) => {
        if (!prevExec) {
          return;
        }
        if (prevExec.status === "RUNNING" && exec.status === "STOPPED") {
          fire({
            shellId: exec.id,
            author: ""
          });
        }
      })
    );
    this.onShellTerminated = this.onShellTerminatedEmitter.event;
  }
  subscribeAndEvaluateExecsUpdates(compare) {
    let prevExecs = [];
    const abortController = new AbortController();
    streamExecsList({
      client: this.apiClient,
      signal: abortController.signal,
      headers: {
        headers: { Accept: "text/event-stream" }
      }
    }).then(async ({ stream: stream4 }) => {
      for await (const evt of stream4) {
        const execListResponse = parseStreamEvent(evt);
        const execs = execListResponse.execs;
        if (prevExecs && execs) {
          execs.forEach((exec) => {
            const prevExec = prevExecs?.find(
              (execItem) => execItem.id === exec.id
            );
            compare(exec, prevExec, prevExecs);
          });
        }
        prevExecs = execs || [];
      }
    });
    return Disposable.create(() => {
      abortController.abort();
    });
  }
  convertExecToShellDTO(exec) {
    return {
      isSystemShell: true,
      name: JSON.stringify({
        type: "command",
        command: exec.command,
        name: ""
      }),
      ownerUsername: "root",
      shellId: exec.id,
      shellType: "TERMINAL",
      startCommand: exec.command,
      status: exec.status
    };
  }
  async create(projectPath, size, command, type, isSystemShell) {
    const args = command ? command.split(" ").slice(1) : [];
    const baseCommand = command ? command.split(" ")[0] : "bash";
    const exec = await createExec({
      client: this.apiClient,
      body: {
        args,
        command: baseCommand,
        interactive: type === "COMMAND" ? false : true
      }
    });
    if (!exec.data) {
      throw new Error(exec.error.message);
    }
    await this.open(exec.data.id, { cols: 200, rows: 80 });
    return {
      ...this.convertExecToShellDTO(exec.data),
      buffer: []
    };
  }
  async delete(shellId) {
    try {
      const exec = await getExec({
        client: this.apiClient,
        path: {
          id: shellId
        }
      });
      if (!exec.data) {
        return null;
      }
      const shellDTO = this.convertExecToShellDTO(exec.data);
      const deleteResponse = await deleteExec({
        client: this.apiClient,
        path: {
          id: shellId
        }
      });
      if (deleteResponse.data) {
        if (this.openShells[shellId]) {
          this.openShells[shellId].abort();
          delete this.openShells[shellId];
        }
        return shellDTO;
      } else {
        return null;
      }
    } catch (error) {
      return null;
    }
  }
  async getShells() {
    const execs = await listExecs({
      client: this.apiClient
    });
    return execs.data?.execs.map((exec) => this.convertExecToShellDTO(exec)) ?? [];
  }
  async open(shellId, size) {
    const abortController = new AbortController();
    this.openShells[shellId] = abortController;
    const exec = await getExec({
      client: this.apiClient,
      path: {
        id: shellId
      }
    });
    if (!exec.data) {
      throw new Error(exec.error.message);
    }
    const { stream: stream4 } = await getExecOutput({
      client: this.apiClient,
      path: { id: shellId },
      query: { lastSequence: 0 },
      signal: abortController.signal,
      headers: {
        Accept: "text/event-stream"
      }
    });
    const buffer = [];
    for await (const evt of stream4) {
      const data = parseStreamEvent(evt);
      if (!buffer.length) {
        buffer.push(data.output);
        break;
      }
    }
    return {
      buffer,
      ...this.convertExecToShellDTO(exec.data)
    };
  }
  async rename(shellId, name) {
    return null;
  }
  async restart(shellId) {
    try {
      await updateExec({
        client: this.apiClient,
        path: {
          id: shellId
        },
        body: {
          status: "running"
        }
      });
      return null;
    } catch (error) {
      return null;
    }
  }
  async send(shellId, input, size) {
    try {
      await execExecStdin({
        client: this.apiClient,
        path: {
          id: shellId
        },
        body: {
          type: "stdin",
          input
        }
      });
      return null;
    } catch (error) {
      return null;
    }
  }
};
var PintPortsClient = class {
  constructor(apiClient, sandboxId) {
    this.apiClient = apiClient;
    this.sandboxId = sandboxId;
    this.onPortsUpdatedEmitter = new EmitterSubscription((fire) => {
      const abortController = new AbortController();
      streamPortsList({
        client: this.apiClient,
        signal: abortController.signal,
        headers: {
          headers: { Accept: "text/event-stream" }
        }
      }).then(async ({ stream: stream4 }) => {
        for await (const evt of stream4) {
          const data = parseStreamEvent(evt);
          fire(
            data.ports.map((pintPort) => ({
              port: pintPort.port,
              url: pintPort.address
            }))
          );
        }
      });
      return Disposable.create(() => {
        abortController.abort();
      });
    });
    this.onPortsUpdated = this.onPortsUpdatedEmitter.event;
  }
  async getPorts() {
    const ports = await listPorts({
      client: this.apiClient
    });
    return ports.data?.ports.map((port2) => ({
      port: port2.port,
      url: `https://${this.sandboxId}-${port2.port}.csb.app`
    })) ?? [];
  }
};
