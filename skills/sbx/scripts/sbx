   */
  entrypoint(entrypointCommands) {
    if (!Array.isArray(entrypointCommands) || !entrypointCommands.every((x) => typeof x === "string")) {
      throw new DaytonaInvalidArgumentError("entrypoint_commands must be a list of strings");
    }
