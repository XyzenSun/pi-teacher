          shell: null,
          // TODO: Map exec to shell if needed
          ports: []
          // TODO: Map ports if available
        };
        this.onTaskUpdateEmitter.fire(taskDTO);
        return taskDTO;
      } else {
        throw new Error(response.error?.message || "Failed to run task");
      }
    } catch (error) {
      console.error("Failed to run task:", error);
      throw error;
    }
  }
  async stopTask(taskId) {
    try {
      const response = await executeTaskAction({
        client: this.apiClient,
        path: { id: taskId },
        query: { actionType: "stop" }
      });
      if (response.data) {
        const taskDTO = {
          id: response.data.id,
          name: response.data.name,
          command: response.data.command,
          runAtStart: false,
          // API doesn't provide this in action response
          shell: null,
          // TODO: Map exec to shell if needed
          ports: []
          // TODO: Map ports if available
        };
        this.onTaskUpdateEmitter.fire(taskDTO);
        return taskDTO;
      } else {
        return null;
      }
    } catch (error) {
      console.error("Failed to stop task:", error);
      return null;
    }
  }
};
var PintClientSetup = class {
  constructor(apiClient) {
    this.apiClient = apiClient;
    this.onSetupProgressUpdateEmitter = new Emitter7();
    this.onSetupProgressUpdate = this.onSetupProgressUpdateEmitter.event;
  }
  async getProgress() {
    try {
      const response = await listSetupTasks({
        client: this.apiClient
      });
      if (response.data) {
        const steps = response.data.setupTasks.map((setupTask) => ({
          name: setupTask.name,
          command: setupTask.command,
          shellId: setupTask.execId || null,
          finishStatus: setupTask.status === "FINISHED" ? "SUCCEEDED" : setupTask.status === "ERROR" ? "FAILED" : null
        }));
        let state = "IDLE";
        let currentStepIndex = 0;
        const hasRunningTask = response.data.setupTasks.some((task2) => task2.status === "RUNNING");
        const allFinished = response.data.setupTasks.every((task2) => task2.status === "FINISHED" || task2.status === "ERROR");
        if (hasRunningTask) {
          state = "IN_PROGRESS";
          currentStepIndex = response.data.setupTasks.findIndex((task2) => task2.status === "RUNNING");
        } else if (allFinished) {
          state = "FINISHED";
          currentStepIndex = steps.length - 1;
        }
        return {
          state,
          steps,
          currentStepIndex: Math.max(0, currentStepIndex)
        };
      } else {
        return {
          state: "IDLE",
          steps: [],
          currentStepIndex: 0
        };
      }
    } catch (error) {
      console.error("Failed to get setup progress:", error);
      return {
        state: "IDLE",
        steps: [],
        currentStepIndex: 0
      };
    }
  }
  async init() {
    const progress = await this.getProgress();
    this.onSetupProgressUpdateEmitter.fire(progress);
    return progress;
  }
};
