var AgentClientFS = class {
  constructor(agentConnection, workspacePath) {
    this.agentConnection = agentConnection;
    this.workspacePath = workspacePath;
  }
  async handleRawFsResponse(method, params) {
    try {
      const result = await this.agentConnection.request({
        method,
        params
      });
      return { type: "ok", result };
    } catch (e) {
      const err2 = e;
      if ("code" in err2) {
        if (err2.code === 102) {
          return {
            type: "error",
            error: err2.message,
            errno: err2.data.errno
          };
        }
        return { type: "error", error: err2.message, errno: null };
      }
      if (err2 instanceof Error) {
        return { type: "error", error: err2.message, errno: null };
      }
      return { type: "error", error: "unknown error", errno: null };
    }
  }
  copy(from, to, recursive, overwrite) {
    return this.handleRawFsResponse("fs/copy", {
      from,
      to,
      recursive,
      overwrite
    });
  }
  async download(path2) {
    return this.agentConnection.request({
      method: "fs/download",
      params: {
        path: path2 || this.workspacePath
      }
    });
  }
  mkdir(path2, recursive) {
    return this.handleRawFsResponse("fs/mkdir", {
      path: path2,
      recursive
    });
  }
  readdir(path2) {
    return this.handleRawFsResponse("fs/readdir", {
      path: path2
    });
  }
  readFile(path2) {
    return this.handleRawFsResponse("fs/readFile", {
      path: path2
    });
  }
  remove(path2, recursive) {
    return this.handleRawFsResponse("fs/remove", {
      path: path2,
      recursive
    });
  }
  rename(path2, newPath) {
    return this.handleRawFsResponse("fs/rename", {
      from: path2,
      to: newPath
    });
  }
  stat(path2) {
    return this.handleRawFsResponse("fs/stat", {
      path: path2
    });
  }
  async watch(path2, options, onEvent) {
    const response = await this.handleRawFsResponse("fs/watch", {
      path: path2,
      recursive: options.recursive,
      // @ts-expect-error angry about using readonly here
      excludes: options.excludes
    });
    if (response.type === "error") {
      return response;
    }
    const watchId = response.result.watchId;
    this.agentConnection.onNotification("fs/watchEvent", (params) => {
      if (params.watchId === watchId) {
        params.events.forEach(onEvent);
      }
    });
    return {
      type: "success",
      dispose: () => {
        this.handleRawFsResponse("fs/unwatch", { watchId });
      }
    };
  }
  writeFile(path2, content, create2, overwrite) {
    return this.handleRawFsResponse("fs/writeFile", {
      path: path2,
      content,
      create: create2,
      overwrite
    });
  }
};
