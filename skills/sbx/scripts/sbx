  constructor(sandboxId, hostToken, tracer) {
    this.sandboxId = sandboxId;
    this.hostToken = hostToken;
    this.tracer = tracer;
  }
  async withSpan(operationName, attributes = {}, operation) {
    if (!this.tracer) {
      return operation();
    }
    return this.tracer.startActiveSpan(
      operationName,
      { attributes },
      async (span) => {
        try {
          const result = await operation();
          span.setStatus({ code: SpanStatusCode.OK });
          return result;
        } catch (error) {
          span.setStatus({
            code: SpanStatusCode.ERROR,
            message: error instanceof Error ? error.message : String(error)
          });
          span.recordException(
            error instanceof Error ? error : new Error(String(error))
          );
          throw error;
        } finally {
          span.end();
        }
      }
    );
  }
  /**
   * If private Sandbox this will return a URL with a host token.
   */
  getUrl(port2, protocol4 = "https") {
    return `${protocol4}://${this.sandboxId}-${port2}.csb.app${this.hostToken ? `?preview_token=${this.hostToken.token}` : ""}`;
  }
  /**
   * If private Sandbox this will return headers with a host token.
   */
  getHeaders() {
