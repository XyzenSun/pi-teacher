async function enhanceFetch(request, instrumentation) {
  const headers = new Headers(
    request instanceof Request ? request.headers : void 0
  );
  const existingUserAgent = headers.get("User-Agent") || "";
  headers.set(
    "User-Agent",
    `${existingUserAgent ? `${existingUserAgent} ` : ""}codesandbox-sdk/${// @ts-expect-error - Replaced at build time
    "2.4.2"}`.trim()
  );
  headers.set("traceparent", generateTraceParent());
  return instrumentation ? instrumentation(
    new Request(request, {
      headers
    })
  ) : fetch(
    new Request(request, {
      headers
    })
  );
}
