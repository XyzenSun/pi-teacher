            return `${name}=${final2}`;
          }
          case "label": {
            return `.${final2}`;
          }
          case "matrix": {
            return `;${name}=${final2}`;
          }
          default: {
            return final2;
          }
        }
      }
      for (const k in value2) {
        const finalName = options.style === "deepObject" ? `${name}[${k}]` : k;
