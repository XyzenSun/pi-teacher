      }
    })
  );
}
function getStartOptions(opts) {
  if (!opts) return {};
  if (opts.hibernationTimeoutSeconds !== void 0 && opts.hibernationTimeoutSeconds < 60) {
    console.warn(
      `Warning: hibernationTimeoutSeconds (${opts.hibernationTimeoutSeconds}s) is less than 60 seconds. This may cause connection instability and frequent disconnections. Consider using at least 60 seconds for stable websocket connections.`
    );
  }
  return {
    ipcountry: opts.ipcountry,
    tier: opts.vmTier?.name,
    hibernation_timeout_seconds: opts.hibernationTimeoutSeconds,
    automatic_wakeup_config: opts.automaticWakeupConfig
  };
}
