var workspaceCreate = (options) => {
  return (options?.client ?? client2).post({
    security: [
      {
        scheme: "bearer",
        type: "http"
      }
    ],
    url: "/org/workspace",
    ...options,
    headers: {
      "Content-Type": "application/json",
      ...options?.headers
    }
  });
};
var tokenCreate = (options) => {
  return (options.client ?? client2).post({
    security: [
      {
        scheme: "bearer",
        type: "http"
      }
    ],
    url: "/org/workspace/{team_id}/tokens",
    ...options,
    headers: {
