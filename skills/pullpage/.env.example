# 本文件是本地直跑测试用的模板。正式部署的密钥走「系统设置 → 高级配置 → 用户环境变量」，
# 由 Pi Teacher 后端注入进程环境（ADR-0034）；skill 目录的 .env 不进镜像（.dockerignore）。
# pullpage 取值优先级：环境变量 > 本目录 .env
TAVILY_API_KEY=tvly-xxxxxxxx
EXA_API_KEY=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
FIRECRAWL_API_KEY=fc-xxxxxxxx
JINA_API_KEY=jina-xxxxxxxx
# 反代地址（可选，缺省用各家官方地址）
TAVILY_BASE_URL=https://api.tavily.com
EXA_BASE_URL=https://api.exa.ai
FIRECRAWL_BASE_URL=https://api.firecrawl.dev
JINA_BASE_URL=https://r.jina.ai
