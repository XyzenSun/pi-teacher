#!/usr/bin/env node
// pullpage：聚合多家在线平台的单 URL 抓取 CLI（markdown 优先）。
//
// 由上游 Go 实现移植为零依赖 Node 单文件：复用镜像自带的 Node 运行时，
// 不需要 Go 工具链、不在仓库存编译产物；改行为就是改本文件。
//
// 用法：pullpage --url URL [--query q] [--format markdown|text|html] [--max-chars N]
//                [--only-main] [--no-cache] [--timeout ms] [--with-links]
//                [--extract-depth basic|advanced] [--provider tavily|exa|firecrawl|jina|all]
//                [--verbose]
//
// --provider 行为（与 Go 版一致）：
//   - 空（默认）：按 tavily → exa → firecrawl → jina 顺序回退，首个成功即返回
//   - 指定单家：仅尝试该家
//   - all：并发抓取所有已配置 key 的服务商，按 "=== provider ===" 分段拼接返回
//
// 退出码：2 = 参数缺 --url；1 = 所有提供商失败；0 = 成功。
import { parseArgs } from "node:util";
import { existsSync, readFileSync } from "node:fs";
import { fileURLToPath } from "node:url";
import path from "node:path";

const USAGE = `Usage of pullpage:
  --url string          目标 URL（必填）
  --query string        内容引导
  --format string       markdown | text | html（默认 markdown）
  --max-chars int       文本上限；0 不限
  --only-main           仅主体内容（默认 true）
  --no-cache            强制不使用缓存
  --timeout int         超时毫秒（默认 30000）
  --with-links          附带提取的链接
  --extract-depth string  tavily: basic | advanced
  --provider string     指定服务商；空则自动回退
  --verbose             输出调试信息到 stderr
`;

function parseCli() {
  let parsed;
  try {
    parsed = parseArgs({
      // allowNegative 让 --no-xxx 关闭对应布尔项：--no-cache => cache=false、--no-only-main => only-main=false。
      // 必须声明正向名 cache：若直接声明 "no-cache"，parseArgs 会把 --no-cache 解析成 "no-cache": false（与直觉相反）。
      allowNegative: true,
      options: {
        url: { type: "string" },
        query: { type: "string" },
        format: { type: "string", default: "markdown" },
        "max-chars": { type: "string", default: "0" },
        "only-main": { type: "boolean", default: true },
        cache: { type: "boolean", default: true },
        timeout: { type: "string", default: "30000" },
        "with-links": { type: "boolean", default: false },
        "extract-depth": { type: "string", default: "" },
        provider: { type: "string", default: "" },
        verbose: { type: "boolean", default: false },
      },
    });
  } catch (error) {
    console.error(`错误：${error.message}`);
    console.error(USAGE);
    process.exit(2);
  }
  const values = parsed.values;
  const maxChars = Number.parseInt(values["max-chars"], 10);
  const timeoutMs = Number.parseInt(values.timeout, 10);
  if (!values.url) {
    console.error("错误：缺少 --url");
    console.error(USAGE);
    process.exit(2);
  }
  return {
    url: values.url,
    query: values.query ?? "",
    format: values.format ?? "markdown",
    maxChars: Number.isFinite(maxChars) ? maxChars : 0,
    onlyMainContent: values["only-main"],
    cacheTolerance: values.cache ? "auto" : "no-cache",
    timeoutMs: Number.isFinite(timeoutMs) ? timeoutMs : 30000,
    includeLinks: values["with-links"],
    extractDepth: values["extract-depth"] ?? "",
    provider: (values.provider ?? "").toLowerCase(),
    verbose: values.verbose,
  };
}

// skill 根目录 = 脚本所在目录的父目录；PULLPAGE_SKILL_DIR 优先（与 Go 版一致）。
function skillRootDir() {
  const fromEnv = process.env.PULLPAGE_SKILL_DIR;
  if (fromEnv) return fromEnv;
  const scriptDir = path.dirname(fileURLToPath(import.meta.url));
  return path.dirname(scriptDir);
}

// .env 只是本地直跑的兜底；正式部署的 key 由 Pi Teacher 注入环境变量（ADR-0034）。
function loadDotenv() {
  const envPath = path.join(skillRootDir(), ".env");
  if (!existsSync(envPath)) return {};
  const values = {};
  for (const rawLine of readFileSync(envPath, "utf8").split(/\r?\n/)) {
    const line = rawLine.trim();
    if (!line || line.startsWith("#")) continue;
    const eq = line.indexOf("=");
    if (eq <= 0) continue;
    const key = line.slice(0, eq).trim();
    const value = line.slice(eq + 1).trim().replace(/^["']|["']$/g, "");
    if (key) values[key] = value;
  }
  return values;
}

// 取值优先级与 tavily-search 相同：环境变量非空优先，其次 .env 兜底。
function getSetting(dotenv, key) {
  const fromEnv = (process.env[key] ?? "").trim();
  if (fromEnv) return fromEnv;
  return dotenv[key] ?? "";
}

function requireKey(dotenv, key) {
  const value = getSetting(dotenv, key).trim();
  if (!value) throw new Error(`缺少 ${key}；请在系统设置 → 高级配置 → 用户环境变量中填入`);
  return value;
}

function envOr(dotenv, key, fallback) {
  const value = getSetting(dotenv, key).trim();
  return value || fallback;
}

// 各家官方 API 默认地址。
const DEFAULT_BASE_URLS = {
  exa: "https://api.exa.ai",
  tavily: "https://api.tavily.com",
  jina: "https://r.jina.ai",
  firecrawl: "https://api.firecrawl.dev",
};

function buildAdapter(name, dotenv) {
  switch (name) {
    case "exa":
      return { name, key: requireKey(dotenv, "EXA_API_KEY"), baseURL: envOr(dotenv, "EXA_BASE_URL", DEFAULT_BASE_URLS.exa) };
    case "tavily":
      return { name, key: requireKey(dotenv, "TAVILY_API_KEY"), baseURL: envOr(dotenv, "TAVILY_BASE_URL", DEFAULT_BASE_URLS.tavily) };
    case "jina":
      return { name, key: requireKey(dotenv, "JINA_API_KEY"), baseURL: envOr(dotenv, "JINA_BASE_URL", DEFAULT_BASE_URLS.jina) };
    case "firecrawl":
      return { name, key: requireKey(dotenv, "FIRECRAWL_API_KEY"), baseURL: envOr(dotenv, "FIRECRAWL_BASE_URL", DEFAULT_BASE_URLS.firecrawl) };
    default:
      throw new Error(`未知服务商：${name}`);
  }
}

function snippet(text) {
  return text.length > 300 ? text.slice(0, 300) : text;
}

async function postJSON(adapter, endpoint, body, timeoutMs) {
  const response = await fetch(`${adapter.baseURL}${endpoint}`, {
    method: "POST",
    headers: { "Content-Type": "application/json", Authorization: `Bearer ${adapter.key}` },
    body: JSON.stringify(body),
    signal: AbortSignal.timeout(timeoutMs),
  });
  const raw = await response.text();
  if (!response.ok) {
    throw new Error(`${adapter.name} HTTP ${response.status}: ${snippet(raw)}`);
  }
  return raw;
}

async function fetchTavily(adapter, req) {
  const body = { urls: [req.url], format: req.format, include_links: req.includeLinks };
  if (req.query) body.query = req.query;
  if (req.extractDepth) body.extract_depth = req.extractDepth; // basic | advanced
  if (req.timeoutMs > 0) body.timeout = Math.floor(req.timeoutMs / 1000); // tavily 用秒
  const raw = await postJSON(adapter, "/extract", body, req.timeoutMs);
  // tavily 抓取失败不依赖 HTTP 状态码，而是 200 + results 空 / failed_results 标记。
  const parsed = JSON.parse(raw);
  const results = parsed.results ?? [];
  if (results.length === 0) {
    const reasons = (parsed.failed_results ?? []).map((item) => `${item.url} (${item.reason})`);
    throw new Error(`tavily 无有效结果；失败：${reasons.join(", ")}`);
  }
  const first = results[0];
  let content = first.raw_content ?? "";
  if (req.maxChars > 0 && content.length > req.maxChars) content = content.slice(0, req.maxChars);
  if (!content.trim()) throw new Error("tavily 内容为空"); // 上游 success 字段不可信，内容空必须机器兜底
  return { content, links: req.includeLinks ? first.links ?? [] : [], provider: "tavily" };
}

async function fetchExa(adapter, req) {
  const body = {
    urls: [req.url],
    text: { verbosity: "compact" },
    maxAgeHours: -1, // 默认不强制 livecrawl
    livecrawlTimeout: req.timeoutMs,
  };
  if (req.maxChars > 0) {
    body.text = { verbosity: "compact", maxCharacters: req.maxChars, includeSections: ["body"] };
  }
  if (req.includeLinks) body.extras = { links: 10 };
  if (req.query) body.highlights = { query: req.query };
  const raw = await postJSON(adapter, "/contents", body, req.timeoutMs);
  // exa 抓取失败返回 200 + statuses error / results 空，不依赖 HTTP 状态码。
  const parsed = JSON.parse(raw);
  const failed = (parsed.statuses ?? [])
    .filter((item) => item.status !== "success")
    .map((item) => `${item.id} (${item.error?.tag})`);
  const results = parsed.results ?? [];
  if (results.length === 0) {
    throw new Error(`exa 无有效结果；失败：${failed.join(", ")}`);
  }
  const first = results[0];
  let content = first.title ? `# ${first.title}\n\n` : "";
  content += first.text ?? "";
  if (!content.trim()) throw new Error("exa 内容为空");
  const cost = parsed.costDollars?.total > 0 ? `$${parsed.costDollars.total.toFixed(4)}` : "";
  return { content, links: req.includeLinks ? first.extras?.links ?? [] : [], provider: "exa", cost };
}

async function fetchFirecrawl(adapter, req) {
  const body = { url: req.url, onlyMainContent: req.onlyMainContent, maxAge: 172800000, timeout: req.timeoutMs };
  // formats：默认 markdown；firecrawl v2 无纯 text，用 markdown 后裁剪。
  if (req.format === "html") body.formats = ["html"];
  else body.formats = ["markdown"];
  if (req.cacheTolerance === "no-cache") body.maxAge = 0;
  const raw = await postJSON(adapter, "/v2/scrape", body, req.timeoutMs);
  // firecrawl 抓取失败返回 200 + success=false，不依赖 HTTP 状态码。
  const parsed = JSON.parse(raw);
  if (!parsed.success) throw new Error(`firecrawl success=false: ${parsed.error ?? ""}`);
  let content = req.format === "html" ? parsed.data?.html ?? "" : parsed.data?.markdown ?? "";
  if (req.maxChars > 0 && content.length > req.maxChars) content = content.slice(0, req.maxChars);
  if (!content.trim()) throw new Error("firecrawl 提取内容为空");
  const links = req.includeLinks ? (parsed.data?.links ?? []).map((item) => item.url) : [];
  return { content, links, provider: "firecrawl" };
}

async function fetchJina(adapter, req) {
  // jina 端点：{baseURL}/{url}；query 参数控制缓存 / 链接 / 超时（timeout 单位秒，上限 180）。
  const query = new URLSearchParams();
  if (req.cacheTolerance === "no-cache") query.set("noCache", "true");
  if (req.includeLinks) query.set("withLinksSummary", "true");
  if (req.timeoutMs > 0) {
    const seconds = Math.min(Math.max(Math.floor(req.timeoutMs / 1000), 1), 180);
    query.set("timeout", String(seconds));
  }
  const endpoint = `${adapter.baseURL}/${req.url}${query.size > 0 ? `?${query}` : ""}`;
  const headers = { Authorization: `Bearer ${adapter.key}` };
  // 默认返回 markdown；用 Accept / X-Return-Format 控制。
  if (req.format === "text") headers.Accept = "text/plain";
  else if (req.format === "html") headers["X-Return-Format"] = "html";
  else headers.Accept = "application/json";
  const response = await fetch(endpoint, { headers, signal: AbortSignal.timeout(req.timeoutMs) });
  const raw = await response.text();
  if (!response.ok) throw new Error(`jina HTTP ${response.status}: ${snippet(raw)}`);

  let content = raw;
  let links = [];
  if ((response.headers.get("content-type") ?? "").includes("application/json")) {
    // Accept: application/json 时 jina 返回 {"code":200,"data":{"content":...}}
    const parsed = JSON.parse(raw);
    if (parsed.code !== 0 && parsed.code !== 200) throw new Error(`jina code ${parsed.code}`);
    content = parsed.data?.content ?? "";
    if (req.includeLinks) links = (parsed.data?.links ?? []).map((item) => item.url);
  }
  if (req.maxChars > 0 && content.length > req.maxChars) content = content.slice(0, req.maxChars);
  if (!content.trim()) throw new Error("jina 提取内容为空");
  return { content, links, provider: "jina" };
}

const FETCHERS = { tavily: fetchTavily, exa: fetchExa, firecrawl: fetchFirecrawl, jina: fetchJina };

async function tryFetch(name, dotenv, req, verbose) {
  let adapter;
  try {
    adapter = buildAdapter(name, dotenv); // key 缺失 / 未知服务商在这里抛出
  } catch (error) {
    throw new Error(`${name}: ${error.message ?? error}`);
  }
  if (verbose) console.error("尝试：", name);
  try {
    const out = await FETCHERS[name](adapter, req);
    if (verbose) console.error("成功：", out.provider, "cost:", out.cost ?? "");
    return out;
  } catch (error) {
    if (verbose) console.error("失败：", error.message ?? error);
    throw new Error(`${name}: ${error.message ?? error}`);
  }
}

// 单家成功结果输出到 stdout；--with-links 时链接列表前置。
function emitSuccess(out, withLinks) {
  if (out.links.length > 0 && withLinks) {
    console.log(`<!-- provider: ${out.provider} -->`);
    for (const link of out.links) console.log("- ", link);
    console.log("---");
  }
  process.stdout.write(out.content);
}

async function main() {
  const req = parseCli();
  const dotenv = loadDotenv();
  const all = ["tavily", "exa", "firecrawl", "jina"];

  if (req.provider === "all") {
    // 并发抓取所有已配置 key 的服务商，按固定顺序分段拼接；任一家成功即计入。
    const settled = await Promise.allSettled(all.map((name) => tryFetch(name, dotenv, req, req.verbose)));
    const failures = settled.filter((item) => item.status === "rejected").map((item) => item.reason.message);
    if (failures.length === all.length) {
      console.error("所有 fetch 提供商均失败：");
      for (const message of failures) console.error("  -", message);
      process.exit(1);
    }
    const chunks = [];
    all.forEach((name, index) => {
      const item = settled[index];
      if (item.status !== "fulfilled") return;
      const out = item.value;
      let section = `=== ${name} ===\n`;
      if (req.includeLinks && out.links.length > 0) {
        for (const link of out.links) section += `- ${link}\n`;
        section += "---\n";
      }
      section += out.content;
      if (!out.content.endsWith("\n")) section += "\n";
      section += "\n";
      chunks.push(section);
    });
    process.stdout.write(chunks.join(""));
    return;
  }

  // 候选顺序：默认 tavily → exa → firecrawl → jina（jina 能力最强留最后兜底）；指定 --provider 则仅该家。
  const order = req.provider ? [req.provider] : all;
  const errors = [];
  for (const name of order) {
    try {
      const out = await tryFetch(name, dotenv, req, req.verbose);
      emitSuccess(out, req.includeLinks);
      return;
    } catch (error) {
      errors.push(error.message ?? String(error));
    }
  }
  console.error("所有 fetch 提供商均失败：");
  for (const message of errors) console.error("  -", message);
  process.exit(1);
}

main().catch((error) => {
  console.error(error.message ?? error);
  process.exit(1);
});
