{
  "name": "pi-teacher-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx src/index.ts",
    "start": "node --import tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "smoke": "tsx src/verify/smoke.ts",
    "verify": "tsx src/verify/run-real.ts",
    "http-smoke": "tsx src/verify/http-smoke.ts",
    "verify:lifecycle": "tsx src/verify/lifecycle.ts",
    "verify:schema": "tsx src/verify/schema-check.ts",
    "verify:config": "tsx src/verify/config-check.ts",
    "verify:attachments": "tsx src/verify/attachments-check.ts",
    "verify:catalog": "tsx src/verify/catalog-check.ts",
    "verify:remote": "tsx src/verify/remote-check.ts"
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "0.84.2",
    "@earendil-works/pi-coding-agent": "0.84.2",
    "better-sqlite3": "^13.0.3",
    "express": "^5.1.0",
    "ts-fsrs": "^5.4.2",
    "tsx": "^4.19.0",
    "typebox": "1.3.7"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "typescript": "^5.6.0"
  }
}
